---
/**
 * Trip Weather Planner — 首頁即時天氣卡（Round 6 定稿移植）
 *
 * 目前資料為 demo 常數。接上真實 API 後只要做兩件事：
 *   1. 把 regions 換成 fetch 回來的資料
 *   2. 設定根元素的 data-state（day / night / alert / offline）——配色與版位會自動切換
 */

export interface WeatherRegion {
	key: string;
	tab: string;
	name: string;
	hi: number;
	lo: number;
	cond: string;
	icon: "sun" | "cloud" | "rain";
	pop: number;
	uv: number;
	aqi: number;
	advice: string;
}

interface Props {
	state?: "day" | "night" | "alert" | "offline";
	regions?: WeatherRegion[];
	href?: string;
	locale?: string;
}

const defaultRegions: WeatherRegion[] = [
	{
		key: "N",
		tab: "北部",
		name: "臺北 · 信義區",
		hi: 31,
		lo: 25,
		cond: "晴時多雲",
		icon: "sun",
		pop: 20,
		uv: 7,
		aqi: 42,
		advice: "白天炎熱，外出補水並備妥雨具；午後雷雨機率偏低，適合安排戶外行程。",
	},
	{
		key: "C",
		tab: "中部",
		name: "臺中 · 西屯區",
		hi: 33,
		lo: 26,
		cond: "晴",
		icon: "sun",
		pop: 10,
		uv: 9,
		aqi: 78,
		advice: "高溫炎熱且紫外線過量，中午前後避免長時間曝曬，空品略差建議減少劇烈運動。",
	},
	{
		key: "S",
		tab: "南部",
		name: "臺南 · 中西區",
		hi: 32,
		lo: 26,
		cond: "午後短暫雨",
		icon: "rain",
		pop: 45,
		uv: 9,
		aqi: 66,
		advice: "午後有短暫雨，安排室內行程較穩妥；出門前建議再確認一次即時雷達。",
	},
	{
		key: "E",
		tab: "東部",
		name: "花蓮 · 花蓮市",
		hi: 29,
		lo: 24,
		cond: "多雲時陰",
		icon: "cloud",
		pop: 35,
		uv: 6,
		aqi: 28,
		advice: "雲量偏多但降雨零星，空品全臺最佳，適合安排海岸線與縱谷行程。",
	},
];

const {
	state = "day",
	regions = defaultRegions,
	href: suppliedHref,
	locale: suppliedLocale = "zh",
} = Astro.props;

const locale = suppliedLocale === "en" || suppliedLocale === "ja" ? suppliedLocale : "zh";
const defaultHref = "https://twpfe5ce0.z23.web.core.windows.net/";
const href = suppliedHref ?? (locale === "zh" ? defaultHref : `${defaultHref}?lang=${locale}`);

const t =
	locale === "en"
		? { pop: "Rain", uv: "UV", aqi: "AQI", cta: "View full forecast", loading: "Loading weather…", retry: "Retry" }
		: locale === "ja"
			? { pop: "降水", uv: "UV", aqi: "AQI", cta: "詳細な天気を見る", loading: "天気を読み込み中…", retry: "再試行" }
			: { pop: "降雨", uv: "紫外線", aqi: "空品", cta: "查看完整天氣預覽", loading: "正在載入天氣…", retry: "重試" };

const uvBands = [
	{ max: 2, color: "#5fd694", label: "低量級" },
	{ max: 5, color: "#ffd166", label: "中量級" },
	{ max: 7, color: "#ff9f43", label: "高量級" },
	{ max: 10, color: "#ff6b6b", label: "過量級" },
	{ max: 99, color: "#b98cff", label: "危險級" },
];

const bandFor = (uv: number) => uvBands.find((b) => uv <= b.max) ?? uvBands[0];
const aqiLabel = (aqi: number) => (aqi <= 50 ? "良好" : aqi <= 100 ? "普通" : "敏感");
const aqiColor = (aqi: number) => (aqi <= 50 ? "#5fd694" : "#ffd76a");

const active = regions[0];
const band = bandFor(active.uv);
const uvPct = Math.min(100, (active.uv / 12) * 100);
const aqiPct = Math.min(100, (active.aqi / 200) * 100);

// 交給 client script 做切換，避免重複打 API
---

<article class="weather-card" aria-busy="true" data-state={state} data-wc-demo-regions={JSON.stringify(regions)} data-wc-locale={locale} data-wc-phase="loading" data-weather-card>
	<div class="weather-card__glow" aria-hidden="true"></div>

	<svg class="weather-card__moonscape" viewBox="0 0 24 24" aria-hidden="true">
		<circle cx="12" cy="12" r="9.4" fill="#e0d4ff"></circle>
		<ellipse cx="8.2" cy="12" rx="6.9" ry="9.4" fill="#120e26"></ellipse>
	</svg>

	<header class="weather-card__head">
		<p class="weather-card__brand">Trip Weather Planner</p>
		<p class="weather-card__status">
			<span class="weather-card__dot" aria-hidden="true"></span>
			<span data-wc-status>{t.loading}</span>
		</p>
	</header>

	<div class="weather-card__tabs" role="tablist">
		{
			regions.map((r, i) => (
				<button
					aria-selected={i === 0 ? "true" : "false"}
					class="weather-card__tab"
					data-wc-tab={r.key}
					role="tab"
					type="button"
				>
					{r.tab}
				</button>
			))
		}
	</div>

	<div class="weather-card__request-state" data-wc-request-state hidden role="status">
		<span data-wc-request-message></span>
		<button class="weather-card__retry" data-wc-retry hidden type="button">{t.retry}</button>
	</div>

	<div class="weather-card__alert" data-wc-alert hidden role="alert">
		<svg viewBox="0 0 17 17" fill="none" aria-hidden="true">
			<path d="M8.5 1.8 16 15H1L8.5 1.8Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"></path>
			<path d="M8.5 6.4v3.9" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
			<circle cx="8.5" cy="12.5" r=".85" fill="currentColor"></circle>
		</svg>
		<div>
			<p class="weather-card__alert-title" data-wc-alert-title></p>
			<p class="weather-card__alert-note" data-wc-alert-note></p>
		</div>
	</div>

	<div class="weather-card__now">
		<div class="weather-card__now-copy">
			<p class="weather-card__place" data-wc-place>{active.name}</p>
			<p class="weather-card__temp">
				<span class="weather-card__temp-value" data-wc-hi>{active.hi}</span>
				<span class="weather-card__temp-unit">°</span>
				<span class="weather-card__temp-lo" data-wc-lo>/ {active.lo}°</span>
			</p>
			<p class="weather-card__cond" data-wc-cond>{active.cond}</p>
		</div>

		<div class="weather-card__icon">
			<div class="weather-card__halo" aria-hidden="true"></div>
			<svg class="weather-card__glyph" data-wc-icon="sun" data-hidden={active.icon !== "sun"} viewBox="0 0 58 58" fill="none">
				<circle cx="24" cy="22" r="9" stroke="var(--wc-accent)" stroke-width="1.5"></circle>
				<path d="M24 5v5M9 22h-4M12 11l3 3M36 10l-3 3" stroke="var(--wc-brand)" stroke-width="1.4" stroke-linecap="round"></path>
				<path d="M22 42a8 8 0 0 1 .6-15.9A11.5 11.5 0 0 1 44 31a7 7 0 0 1-.4 11H22Z" stroke="var(--wc-accent)" stroke-width="1.5" stroke-linejoin="round"></path>
			</svg>
			<svg class="weather-card__glyph" data-wc-icon="cloud" data-hidden={active.icon !== "cloud"} viewBox="0 0 58 58" fill="none">
				<circle cx="21" cy="20" r="7.5" stroke="var(--wc-brand)" stroke-width="1.4"></circle>
				<path d="M18 41a8.5 8.5 0 0 1 .6-16.9A12 12 0 0 1 41.4 28a7.5 7.5 0 0 1-.4 13H18Z" stroke="var(--wc-accent)" stroke-width="1.5" stroke-linejoin="round"></path>
			</svg>
			<svg class="weather-card__glyph" data-wc-icon="rain" data-hidden={active.icon !== "rain"} viewBox="0 0 58 58" fill="none">
				<path d="M17 32a8.5 8.5 0 0 1 .6-16.9A12 12 0 0 1 40.4 19a7.5 7.5 0 0 1-.4 13H17Z" stroke="var(--wc-accent)" stroke-width="1.5" stroke-linejoin="round"></path>
				<path d="M20 39l-2.5 7M29 39l-2.5 7M38 39l-2.5 7" stroke="var(--wc-brand)" stroke-width="1.5" stroke-linecap="round"></path>
			</svg>
			<svg class="weather-card__glyph weather-card__glyph--night" viewBox="0 0 24 24" fill="none" stroke="var(--wc-accent)" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
				<path d="M12.5 3.2a5.3 5.3 0 0 0 6.4 7.1 5.9 5.9 0 1 1-6.4-7.1z"></path>
				<path d="M4.2 14.6A3.2 3.2 0 0 1 7 9.9"></path>
				<path d="M3.6 15.4h10.2" opacity=".55"></path>
				<path d="M6 19l-.7 2M10 19l-.7 2M14 19l-.7 2"></path>
			</svg>
			<svg class="weather-card__glyph weather-card__glyph--storm" viewBox="0 0 58 58" fill="none">
				<path d="M17 30a8.5 8.5 0 0 1 .6-16.9A12 12 0 0 1 40.4 17a7.5 7.5 0 0 1-.4 13H17Z" stroke="#ff9aa5" stroke-width="1.5" stroke-linejoin="round"></path>
				<path d="M20 37l-3 8M28 37l-3 8M36 37l-3 8M24 44l-2.5 6" stroke="#ffd2d8" stroke-width="1.5" stroke-linecap="round"></path>
			</svg>
		</div>
	</div>

	<div class="weather-card__metrics">
		<div class="weather-card__metric">
			<p class="weather-card__metric-head">
				<span class="weather-card__metric-label">{t.pop}</span>
				<span class="weather-card__metric-value" data-wc-pop>{active.pop}%</span>
			</p>
			<div class="weather-card__track">
				<div class="weather-card__bar" data-wc-pop-bar style={`width:${active.pop}%`}></div>
			</div>
		</div>

		<div class="weather-card__metric weather-card__metric--uv">
			<p class="weather-card__metric-head">
				<span class="weather-card__metric-label">{t.uv}</span>
				<span class="weather-card__metric-value">
					<span data-wc-uv>{active.uv}</span>
					<span class="weather-card__metric-tier" data-wc-uv-label style={`color:${band.color}`}>{band.label}</span>
				</span>
			</p>
			<div class="weather-card__track weather-card__track--uv">
				<div class="weather-card__uv-clip">
					<div
						class="weather-card__uv-fill"
						data-wc-uv-fill
						style={`width:${uvPct}%;background:linear-gradient(90deg, ${band.color}1f, ${band.color})`}
					></div>
				</div>
				<div
					class="weather-card__uv-mark"
					data-wc-uv-mark
					style={`left:${uvPct}%;border-color:${band.color}`}
				></div>
			</div>
		</div>

		<div class="weather-card__metric weather-card__metric--moon">
			<svg viewBox="0 0 24 24" aria-hidden="true">
				<circle cx="12" cy="12" r="9.4" fill="#efe8ff"></circle>
				<ellipse cx="8.2" cy="12" rx="6.9" ry="9.4" fill="#151030"></ellipse>
				<circle cx="12" cy="12" r="9.4" fill="none" stroke="rgba(201,184,255,.35)" stroke-width=".7"></circle>
			</svg>
			<p class="weather-card__moon-copy">
				<span class="weather-card__moon-value" data-wc-moon-value>—</span>
				<span class="weather-card__moon-label" data-wc-moon-label>—</span>
			</p>
		</div>

		<div class="weather-card__metric">
			<p class="weather-card__metric-head">
				<span class="weather-card__metric-label">{t.aqi}</span>
				<span class="weather-card__metric-value">
					<span data-wc-aqi>{active.aqi}</span>
					<span class="weather-card__metric-tier" data-wc-aqi-label style={`color:${aqiColor(active.aqi)}`}>
						{aqiLabel(active.aqi)}
					</span>
				</span>
			</p>
			<div class="weather-card__aqi-track">
				<div class="weather-card__aqi-mark" data-wc-aqi-mark style={`left:${aqiPct}%`}></div>
			</div>
		</div>
	</div>

	<p class="weather-card__advice">
		<svg viewBox="0 0 14 14" fill="none" aria-hidden="true">
			<path d="M7 1.4 8.5 5 12.2 5.4 9.5 8 10.3 11.7 7 9.8 3.7 11.7 4.5 8 1.8 5.4 5.5 5Z" stroke="var(--wc-accent)" stroke-width="1.1" stroke-linejoin="round"></path>
		</svg>
		<span data-wc-advice>{active.advice}</span>
	</p>

	<a class="weather-card__foot" href={href}>
		<span class="weather-card__stack">CWA · FastAPI · Azure</span>
		<span class="weather-card__cta" data-wc-cta>{t.cta} →</span>
	</a>
</article>

<script>
	import { loadHomepageWeatherRegionWithRecovery, type TripWeatherRegion, type WeatherLocale } from "../lib/tripWeather";

	const card = document.querySelector<HTMLElement>("[data-weather-card]");
	if (card) {
		const locale: WeatherLocale = card.dataset.wcLocale === "en" || card.dataset.wcLocale === "ja" ? card.dataset.wcLocale : "zh";
		const copy = {
			zh: { live: "即時更新", partial: "部分即時更新", offline: "離線示範資料，無法更新", unavailable: "暫無資料", demo: "示範", active: "則生效中", waking: "服務喚醒中…" },
			en: { live: "Live", partial: "Partial live update", offline: "Offline demo data — unable to update", unavailable: "Unavailable", demo: "Demo", active: "active", waking: "Waking service…" },
			ja: { live: "ライブ更新", partial: "一部ライブ更新", offline: "オフラインのデモデータ — 更新できません", unavailable: "利用不可", demo: "デモ", active: "件有効", waking: "サービス起動中…" },
		}[locale];
		const q = <T extends Element>(selector: string): T | null => card.querySelector<T>(selector);
		const setText = (selector: string, value: string): void => {
			const element = q<HTMLElement>(selector);
			if (element) element.textContent = value;
		};
		const clamp = (value: number, max: number): number => Math.min(max, Math.max(0, value));
		const numberOrNull = (value: number | null): number | null =>
			typeof value === "number" && Number.isFinite(value) ? value : null;
		const pct = (value: number | null, divisor: number): number => (value === null ? 0 : clamp((value / divisor) * 100, 100));
		const uvBand = (uv: number | null): { color: string; label: string } => {
			if (uv === null) return { color: "#8fa6ba", label: copy.unavailable };
			if (uv <= 2) return { color: "#5fd694", label: locale === "en" ? "Low" : locale === "ja" ? "低い" : "低量級" };
			if (uv <= 5) return { color: "#ffd166", label: locale === "en" ? "Moderate" : locale === "ja" ? "中程度" : "中量級" };
			if (uv <= 7) return { color: "#ff9f43", label: locale === "en" ? "High" : locale === "ja" ? "高い" : "高量級" };
			return { color: "#ff6b6b", label: locale === "en" ? "Very high" : locale === "ja" ? "非常に高い" : "過量級" };
		};
		const aqiTier = (aqi: number | null, isDemo: boolean): { color: string; label: string } => {
			if (aqi === null) return { color: "#8fa6ba", label: copy.unavailable };
			if (isDemo) return { color: "#ffd76a", label: copy.demo };
			return { color: aqi <= 50 ? "#5fd694" : "#ffd76a", label: aqi <= 50 ? (locale === "en" ? "Good" : locale === "ja" ? "良好" : "良好") : (locale === "en" ? "Moderate" : locale === "ja" ? "普通" : "普通") };
		};
		const taipeiMinutes = (): number => {
			const parts = new Intl.DateTimeFormat("en-GB", { timeZone: "Asia/Taipei", hour: "2-digit", minute: "2-digit", hourCycle: "h23" }).formatToParts(new Date());
			const hour = Number(parts.find((part) => part.type === "hour")?.value ?? 12);
			const minute = Number(parts.find((part) => part.type === "minute")?.value ?? 0);
			return hour * 60 + minute;
		};
		const timeMinutes = (value: string | null | undefined): number | null => {
			const match = /^(?:[01]\d|2[0-3]):[0-5]\d$/.exec(value ?? "");
			return match ? Number(match[0].slice(0, 2)) * 60 + Number(match[0].slice(3)) : null;
		};
		const isNight = (region: TripWeatherRegion): boolean => {
			const sunrise = timeMinutes(region.sunriseSunset?.sunrise_time);
			const sunset = timeMinutes(region.sunriseSunset?.sunset_time);
			if (sunrise === null || sunset === null || sunrise >= sunset) return false;
			const now = taipeiMinutes();
			return now < sunrise || now >= sunset;
		};
		const formatTime = (iso: string): string => new Intl.DateTimeFormat(locale === "zh" ? "zh-TW" : locale === "ja" ? "ja-JP" : "en-GB", { timeZone: "Asia/Taipei", hour: "2-digit", minute: "2-digit", hourCycle: "h23" }).format(new Date(iso));

		type DemoRegion = Pick<TripWeatherRegion, "key" | "tab" | "name" | "hi" | "lo" | "cond" | "icon" | "pop" | "uv" | "aqi" | "advice">;
		const fallbackRegions: DemoRegion[] = (() => {
			try {
				const parsed: unknown = JSON.parse(card.dataset.wcDemoRegions ?? "[]");
				return Array.isArray(parsed) ? parsed as DemoRegion[] : [];
			} catch {
				return [];
			}
		})();
		const byKey = new Map<string, TripWeatherRegion>();
		type TabPhase = "idle" | "loading" | "ready" | "error";
		const tabPhase = new Map<string, TabPhase>();
		const tabs = Array.from(card.querySelectorAll<HTMLButtonElement>("[data-wc-tab]"));
		const defaultKey = tabs[0]?.dataset.wcTab || "N";
		let selectedKey = defaultKey;
		let requestSerial = 0;
		const requestState = q<HTMLElement>("[data-wc-request-state]");
		const retryButton = q<HTMLButtonElement>("[data-wc-retry]");
		const updateSelectedTab = (): void => {
			tabs.forEach((tab) => tab.setAttribute("aria-selected", String(tab.dataset.wcTab === selectedKey)));
		};
		const showRequestState = (message: string, retry = false): void => {
			if (requestState) requestState.hidden = false;
			setText("[data-wc-request-message]", message);
			if (retryButton) retryButton.hidden = !retry;
		};
		const hideRequestState = (): void => {
			if (requestState) requestState.hidden = true;
			if (retryButton) retryButton.hidden = true;
		};
		const tabLabel = (key: string): string => tabs.find((tab) => tab.dataset.wcTab === key)?.textContent?.trim() || key;
		const paint = (key: string): void => {
			const region = byKey.get(key);
			if (!region) return;
			const uv = numberOrNull(region.uv);
			const aqi = numberOrNull(region.aqi);
			const uvStyle = uvBand(uv);
			const aqiStyle = aqiTier(aqi, region.isDemoAqi);
			const hasWarning = region.warnings.length > 0;
			const state = hasWarning ? "alert" : isNight(region) ? "night" : "day";
			card.dataset.state = state;
			setText("[data-wc-place]", region.name);
			setText("[data-wc-hi]", String(clamp(region.hi, 99)));
			setText("[data-wc-lo]", `/ ${clamp(region.lo, 99)}°`);
			setText("[data-wc-cond]", region.cond || copy.unavailable);
			setText("[data-wc-advice]", region.advice || copy.unavailable);
			setText("[data-wc-pop]", `${clamp(region.pop, 100)}%`);
			const popBar = q<HTMLElement>("[data-wc-pop-bar]");
			if (popBar) popBar.style.width = `${clamp(region.pop, 100)}%`;
			setText("[data-wc-uv]", uv === null ? "—" : String(uv));
			setText("[data-wc-uv-label]", uvStyle.label);
			const uvFill = q<HTMLElement>("[data-wc-uv-fill]");
			const uvMark = q<HTMLElement>("[data-wc-uv-mark]");
			const uvLabel = q<HTMLElement>("[data-wc-uv-label]");
			const uvPercent = pct(uv, 12);
			if (uvFill) { uvFill.style.width = `${uvPercent}%`; uvFill.style.background = `linear-gradient(90deg, ${uvStyle.color}1f, ${uvStyle.color})`; }
			if (uvMark) { uvMark.style.left = `${uvPercent}%`; uvMark.style.borderColor = uvStyle.color; }
			if (uvLabel) uvLabel.style.color = uvStyle.color;
			setText("[data-wc-aqi]", aqi === null ? "—" : String(aqi));
			const aqiLabel = q<HTMLElement>("[data-wc-aqi-label]");
			if (aqiLabel) { aqiLabel.textContent = aqiStyle.label; aqiLabel.style.color = aqiStyle.color; aqiLabel.title = region.isDemoAqi ? (region.aqiSource || copy.demo) : (region.aqiSource || ""); }
			const aqiMark = q<HTMLElement>("[data-wc-aqi-mark]");
			if (aqiMark) aqiMark.style.left = `${pct(aqi, 200)}%`;
			const alert = q<HTMLElement>("[data-wc-alert]");
			if (alert) alert.hidden = !hasWarning;
			if (hasWarning) { setText("[data-wc-alert-title]", region.warnings[0].title || copy.unavailable); setText("[data-wc-alert-note]", `${region.warnings.length} ${copy.active}`); }
			const illumination = typeof region.moon?.illumination_fraction === "number" && Number.isFinite(region.moon.illumination_fraction) ? Math.round(clamp(region.moon.illumination_fraction, 1) * 100) : null;
			setText("[data-wc-moon-value]", state === "night" && illumination !== null ? `${illumination}%` : "—");
			setText("[data-wc-moon-label]", state === "night" && region.moon?.phase ? region.moon.phase : "—");
			card.querySelectorAll<HTMLElement>("[data-wc-icon]").forEach((node) => node.toggleAttribute("data-hidden", node.dataset.wcIcon !== region.icon));
			updateSelectedTab();
		};

		const loadTab = async (key: string): Promise<void> => {
			if (tabPhase.get(key) === "loading" || tabPhase.get(key) === "ready") return;
			const requestId = ++requestSerial;
			tabPhase.set(key, "loading");
			if (selectedKey === key) {
				card.dataset.wcPhase = "loading";
				card.setAttribute("aria-busy", "true");
				setText("[data-wc-status]", copy.loading);
				showRequestState(`${copy.loading} ${tabLabel(key)}`);
			}
			try {
				const result = await loadHomepageWeatherRegionWithRecovery(key as "N" | "C" | "S" | "E", {
					locale,
					onRetry: () => {
						if (selectedKey === key) setText("[data-wc-status]", copy.waking);
					},
				});
				card.dataset.wcAttempts = String(result.attempts);
				const region = result.regions[0];
				if (!region) throw new Error(result.failures[0]?.error || "Weather unavailable");
				byKey.set(key, region);
				tabPhase.set(key, "ready");
				if (selectedKey === key && requestId <= requestSerial) {
					paint(key);
					hideRequestState();
					card.dataset.wcPhase = "live";
					card.setAttribute("aria-busy", "false");
					setText("[data-wc-status]", `${copy.live} · ${formatTime(region.fetchedAt)}`);
				}
			} catch {
				tabPhase.set(key, "error");
				if (selectedKey === key) {
					card.dataset.wcPhase = "error";
					card.setAttribute("aria-busy", "false");
					setText("[data-wc-status]", copy.unavailable);
					showRequestState(`${tabLabel(key)} · ${copy.unavailable}`, true);
				}
			}
		};
		const selectTab = (key: string): void => {
			selectedKey = key;
			updateSelectedTab();
			const phase = tabPhase.get(key) ?? "idle";
			if (phase === "ready") {
				paint(key);
				hideRequestState();
				card.setAttribute("aria-busy", "false");
				return;
			}
			if (phase === "loading") {
				card.setAttribute("aria-busy", "true");
				setText("[data-wc-status]", copy.loading);
				showRequestState(`${copy.loading} ${tabLabel(key)}`);
				return;
			}
			if (phase === "error") showRequestState(`${tabLabel(key)} · ${copy.unavailable}`, true);
			void loadTab(key);
		};
		tabs.forEach((tab) => tab.addEventListener("click", () => {
			const key = tab.dataset.wcTab;
			if (key) selectTab(key);
		}));
		retryButton?.addEventListener("click", () => {
			tabPhase.set(selectedKey, "idle");
			void loadTab(selectedKey);
		});
		void loadTab(defaultKey);
	}
</script>

