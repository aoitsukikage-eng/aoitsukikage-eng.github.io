---
interface Props {
	locale?: "zh" | "en";
}

const { locale = "zh" } = Astro.props;

const copy = {
	zh: {
		title: "SKILL TREE",
		unspent: "UNSPENT",
		unspentVal: "4",
		tabs: [
			{ key: "A", rune: "ᚲ", label: "CORE" },
			{ key: "B", rune: "ᚹ", label: "TOOLS" },
			{ key: "C", rune: "ᚠ", label: "FINANCE" },
		],
		defaultHint: "16 項技能 · 4 項待習得 · hover 節點查看細節",
		notAcquired: "尚未習得 · 下一階段目標",
	},
	en: {
		title: "SKILL TREE",
		unspent: "UNSPENT",
		unspentVal: "4",
		tabs: [
			{ key: "A", rune: "ᚲ", label: "CORE" },
			{ key: "B", rune: "ᚹ", label: "TOOLS" },
			{ key: "C", rune: "ᚠ", label: "FINANCE" },
		],
		defaultHint: "16 skills · 4 planned · hover a node for details",
		notAcquired: "Not acquired · Next goal",
	},
}[locale];
---

<section class="skill-tree-shell section-card" id="home-skill-tree">
	<div class="hud-grid-bg"></div>
	<div class="hud-corner hud-corner--tl"></div>
	<div class="hud-corner hud-corner--tr"></div>
	<div class="hud-corner hud-corner--bl"></div>
	<div class="hud-corner hud-corner--br"></div>

	<div class="skill-tree-content">
		<div class="skill-tree-head">
			<span class="skill-tree-title">{copy.title}</span>
			<span class="skill-tree-line"></span>
			<span class="skill-tree-unspent">
				{copy.unspent} <span class="unspent-num">{copy.unspentVal}</span>
			</span>
		</div>

		<div class="skill-tree-tabs">
			{
				copy.tabs.map((tab, idx) => (
					<button
						type="button"
						class={`skill-tab-btn ${idx === 0 ? "active" : ""}`}
						data-tab-target={tab.key}
					>
						<span class="rune-icon">{tab.rune}</span>
						<span>{tab.label}</span>
					</button>
				))
			}
		</div>

		<div class="skill-tree-canvas" data-skill-canvas>
			<!-- TAB A: CORE -->
			<div class="tree-panel active" data-tree-panel="A">
				<div class="tree-stage">
					<svg viewBox="0 0 330 312" width="330" height="312" class="tree-svg">
						<path d="M 43 58 V 75 H 165 V 91" fill="none" stroke="rgba(3,8,18,.9)" stroke-width="4"></path>
						<path d="M 43 58 V 75 H 165 V 91" fill="none" stroke="rgba(91,231,255,.5)" stroke-width="1.6"></path>
						<polygon points="161,85 169,85 165,92" fill="rgba(91,231,255,.5)"></polygon>
						<path d="M 287 58 V 75 H 287 V 91" fill="none" stroke="rgba(3,8,18,.9)" stroke-width="4"></path>
						<path d="M 287 58 V 75 H 287 V 91" fill="none" stroke="rgba(91,231,255,.2)" stroke-width="1.6" stroke-dasharray="4 4"></path>
						<polygon points="283,85 291,85 287,92" fill="rgba(91,231,255,.2)"></polygon>
						<path d="M 165 138 V 155 H 165 V 171" fill="none" stroke="rgba(3,8,18,.9)" stroke-width="4"></path>
						<path d="M 165 138 V 155 H 165 V 171" fill="none" stroke="rgba(91,231,255,.2)" stroke-width="1.6" stroke-dasharray="4 4"></path>
						<polygon points="161,165 169,165 165,172" fill="rgba(91,231,255,.2)"></polygon>
					</svg>
					<div
						data-skill="Python"
						data-state="mastered"
						data-proj={locale === "zh" ? "Trip Weather Planner · 資料分析腳本" : "Trip Weather Planner · Data scripts"}
						data-lv="4"
						class="skill-node node-mastered"
						style="left:20px;top:12px;"
					>
						<img src="https://api.iconify.design/simple-icons:python.svg?color=%23a8e8ff&width=26&height=26" alt="Python" />
						<span class="node-lv">4</span>
					</div>
					<div
						data-skill="SQL"
						data-state="mastered"
						data-proj={locale === "zh" ? "資料查詢與清理" : "Data querying & cleaning"}
						data-lv="3"
						class="skill-node node-mastered"
						style="left:264px;top:12px;"
					>
						<img src="https://api.iconify.design/tabler:database.svg?color=%23a8e8ff&width=26&height=26" alt="SQL" />
						<span class="node-lv">3</span>
					</div>
					<div
