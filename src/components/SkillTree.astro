						<span class="node-lv">4</span>
					</div>
					<div
						data-skill="React · Astro"
						data-state="learning"
						data-proj={locale === "zh" ? "個人網站 · Trip Weather 前端" : "Personal site · Trip Weather frontend"}
						data-lv="2"
						class="skill-node node-learning"
						style="left:142px;top:92px;"
					>
						<img src="https://api.iconify.design/simple-icons:react.svg?color=%23a5f0c6&width=26&height=26" alt="React · Astro" />
						<span class="node-lv">2</span>
					</div>
					<div
						data-skill="Notion"
						data-state="mastered"
						data-proj={locale === "zh" ? "Portfolio 作品集" : "Portfolio docs"}
						data-lv="3"
						class="skill-node node-mastered"
						style="left:264px;top:92px;"
