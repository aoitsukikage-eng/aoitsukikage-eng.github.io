			<!-- TAB C: FINANCE -->
			<div class="tree-panel" data-tree-panel="C">
				<div class="tree-stage">
					<svg viewBox="0 0 330 312" width="330" height="312" class="tree-svg">
						<path d="M 43 58 V 75 H 165 V 91" fill="none" stroke="rgba(3,8,18,.9)" stroke-width="4"></path>
						<path d="M 43 58 V 75 H 165 V 91" fill="none" stroke="rgba(91,231,255,.5)" stroke-width="1.6"></path>
						<polygon points="161,85 169,85 165,92" fill="rgba(91,231,255,.5)"></polygon>
						<path d="M 165 138 V 155 H 165 V 171" fill="none" stroke="rgba(3,8,18,.9)" stroke-width="4"></path>
						<path d="M 165 138 V 155 H 165 V 171" fill="none" stroke="rgba(91,231,255,.5)" stroke-width="1.6"></path>
						<polygon points="161,165 169,165 165,172" fill="rgba(91,231,255,.5)"></polygon>
						<path d="M 165 218 V 235 H 287 V 251" fill="none" stroke="rgba(3,8,18,.9)" stroke-width="4"></path>
						<path d="M 165 218 V 235 H 287 V 251" fill="none" stroke="rgba(91,231,255,.2)" stroke-width="1.6" stroke-dasharray="4 4"></path>
						<polygon points="283,245 291,245 287,252" fill="rgba(91,231,255,.2)"></polygon>
					</svg>
					<div
						data-skill="Securities Settlement"
						data-state="mastered"
						data-proj={locale === "zh" ? "券商結算交割實習" : "Securities settlement internship"}
						data-lv="3"
						class="skill-node node-mastered"
						style="left:20px;top:12px;"
					>
						<img src="https://api.iconify.design/tabler:building-bank.svg?color=%23a8e8ff&width=26&height=26" alt="Securities Settlement" />
						<span class="node-lv">3</span>
					</div>
					<div
						data-skill="ESG Assessment"
						data-state="mastered"
						data-proj={locale === "zh" ? "NTPU ESG Center 研究" : "NTPU ESG Center research"}
						data-lv="3"
						class="skill-node node-mastered"
						style="left:264px;top:12px;"
					>
						<img src="https://api.iconify.design/tabler:scale.svg?color=%23a8e8ff&width=26&height=26" alt="ESG Assessment" />
						<span class="node-lv">3</span>
					</div>
					<div
						data-skill="Portfolio Optimization"
						data-state="mastered"
						data-proj={locale === "zh" ? "Sharpe Ratio 投組研究" : "Sharpe Ratio portfolio study"}
						data-lv="3"
						class="skill-node node-mastered"
						style="left:142px;top:92px;"
					>
						<img src="https://api.iconify.design/tabler:chart-pie.svg?color=%23a8e8ff&width=26&height=26" alt="Portfolio Optimization" />
						<span class="node-lv">3</span>
					</div>
					<div
						data-skill="Sharpe Ratio Analysis"
						data-state="mastered"
						data-proj={locale === "zh" ? "風險調整後報酬分析" : "Risk-adjusted return analysis"}
						data-lv="3"
						class="skill-node node-mastered"
						style="left:142px;top:172px;"
					>
						<img src="https://api.iconify.design/tabler:chart-candle.svg?color=%23a8e8ff&width=26&height=26" alt="Sharpe Ratio Analysis" />
						<span class="node-lv">3</span>
					</div>
					<div
						data-skill="Factor Models"
						data-state="planned"
						data-proj=""
						data-lv="0"
						class="skill-node node-planned"
						style="left:264px;top:252px;"
					>
						<img src="https://api.iconify.design/tabler:math-function.svg?color=%234a7f96&width=26&height=26" alt="Factor Models" />
						<span class="node-lv">0</span>
					</div>
				</div>
			</div>
		</div>

		<div class="skill-info-box" data-skill-info data-not-acquired={copy.notAcquired} data-default-hint={copy.defaultHint}>
			<div class="info-top-row">
				<span class="info-state" data-sk-state>IDLE</span>
				<span class="info-name" data-sk-name>SELECT A NODE</span>
				<span class="info-spacer"></span>
				<span class="info-lv" data-sk-lv></span>
			</div>
			<div class="info-proj" data-sk-proj>{copy.defaultHint}</div>
		</div>
	</div>
</section>

<script>
	function initSkillTree() {
		const shell = document.getElementById("home-skill-tree");
		if (!shell) return;

		const tabBtns = shell.querySelectorAll<HTMLButtonElement>("[data-tab-target]");
		const panels = shell.querySelectorAll<HTMLElement>("[data-tree-panel]");
		const infoBox = shell.querySelector<HTMLElement>("[data-skill-info]");

		if (!infoBox) return;

		const stateEl = infoBox.querySelector<HTMLElement>("[data-sk-state]");
		const nameEl = infoBox.querySelector<HTMLElement>("[data-sk-name]");
		const lvEl = infoBox.querySelector<HTMLElement>("[data-sk-lv]");
		const projEl = infoBox.querySelector<HTMLElement>("[data-sk-proj]");

		const defaultHint = infoBox.dataset.defaultHint || "";
		const notAcquired = infoBox.dataset.notAcquired || "";

		const stateMap: Record<string, [string, string]> = {
			mastered: ["MASTERED", "#5be7ff"],
			learning: ["LEARNING", "#8fe0b0"],
			planned: ["PLANNED", "rgba(183,236,255,.5)"],
		};

		function resetInfo() {
			if (stateEl) {
				stateEl.textContent = "IDLE";
				stateEl.style.color = "rgba(183,236,255,.35)";
			}
			if (nameEl) {
				nameEl.textContent = "SELECT A NODE";
				nameEl.style.color = "rgba(183,236,255,.45)";
			}
			if (lvEl) {
				lvEl.textContent = "";
			}
			if (projEl) {
				projEl.textContent = defaultHint;
				projEl.style.color = "rgba(183,236,255,.42)";
			}
		}

		tabBtns.forEach((btn) => {
			btn.addEventListener("click", () => {
				const target = btn.dataset.tabTarget;
				tabBtns.forEach((b) => b.classList.remove("active"));
				btn.classList.add("active");

				panels.forEach((p) => {
					if (p.dataset.treePanel === target) {
						p.classList.add("active");
					} else {
						p.classList.remove("active");
					}
				});
				resetInfo();
			});
		});

		const nodes = shell.querySelectorAll<HTMLElement>("[data-skill]");
		nodes.forEach((node) => {
			node.addEventListener("mouseenter", () => {
				const sk = node.dataset.skill || "";
				const stKey = node.dataset.state || "mastered";
				const lv = node.dataset.lv || "0";
				const proj = node.dataset.proj || "";

				const stInfo = stateMap[stKey] || stateMap.mastered;

				if (stateEl) {
					stateEl.textContent = stInfo[0];
					stateEl.style.color = stInfo[1];
				}
				if (nameEl) {
					nameEl.textContent = sk;
					nameEl.style.color = "#e6f7ff";
				}
				if (lvEl) {
					lvEl.textContent = stKey === "planned" ? "LV 0 / 5" : `LV ${lv} / 5`;
				}
				if (projEl) {
					projEl.textContent = proj || notAcquired;
					projEl.style.color = proj ? "rgba(183,236,255,.8)" : "rgba(183,236,255,.42)";
				}
			});

			node.addEventListener("mouseleave", () => {
				resetInfo();
			});
		});
	}

	document.addEventListener("DOMContentLoaded", initSkillTree);
	document.addEventListener("astro:page-load", initSkillTree);
	initSkillTree();
</script>

<style>
	.skill-tree-shell {
		box-sizing: border-box;
		position: relative;
		overflow: hidden;
		padding: 20px 20px 18px;
		border: 1px solid rgba(91, 231, 255, 0.34);
		border-radius: 4px;
		background: linear-gradient(180deg, rgba(9, 19, 42, 0.96), rgba(6, 13, 29, 0.96));
		box-shadow: 0 0 0 1px rgba(5, 11, 23, 0.9), 0 20px 52px rgba(91, 231, 255, 0.07);
	}

	.hud-grid-bg {
		position: absolute;
		inset: 0;
		pointer-events: none;
		opacity: 0.5;
		background-image: linear-gradient(rgba(91, 231, 255, 0.055) 1px, transparent 1px),
			linear-gradient(90deg, rgba(91, 231, 255, 0.055) 1px, transparent 1px);
		background-size: 26px 26px;
	}

	.hud-corner {
		position: absolute;
		width: 16px;
		height: 16px;
		pointer-events: none;
	}

	.hud-corner--tl { top: -1px; left: -1px; border-top: 2px solid #5be7ff; border-left: 2px solid #5be7ff; }
	.hud-corner--tr { top: -1px; right: -1px; border-top: 2px solid #5be7ff; border-right: 2px solid #5be7ff; }
	.hud-corner--bl { bottom: -1px; left: -1px; border-bottom: 2px solid #5be7ff; border-left: 2px solid #5be7ff; }
	.hud-corner--br { bottom: -1px; right: -1px; border-bottom: 2px solid #5be7ff; border-right: 2px solid #5be7ff; }

	.skill-tree-content {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 14px;
	}

	.skill-tree-head {
		display: flex;
		align-items: center;
		gap: 12px;
	}

	.skill-tree-title {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 10px;
		letter-spacing: 0.26em;
		color: #5be7ff;
	}

	.skill-tree-line {
		flex: 1;
		height: 1px;
		background: linear-gradient(90deg, rgba(91, 231, 255, 0.36), rgba(91, 231, 255, 0.04));
	}

	.skill-tree-unspent {
		font-family: 'JetBrains Mono', monospace;
		font-size: 9px;
		letter-spacing: 0.08em;
		color: rgba(183, 236, 255, 0.55);
	}

	.unspent-num {
		color: #5be7ff;
	}

	.skill-tree-tabs {
		display: flex;
		gap: 6px;
	}

	.skill-tab-btn {
		flex: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 6px;
		padding: 7px 4px;
		cursor: pointer;
		font-family: var(--font-display);
		font-size: 8.5px;
		letter-spacing: 0.14em;
		transition: all 200ms ease;
		border: 1px solid rgba(91, 231, 255, 0.16);
		background: rgba(6, 13, 29, 0.7);
		color: rgba(183, 236, 255, 0.45);
	}

	.skill-tab-btn.active {
		border-color: rgba(91, 231, 255, 0.7);
		background: linear-gradient(180deg, rgba(18, 46, 84, 0.95), rgba(9, 22, 44, 0.95));
		color: #dff6ff;
		box-shadow: inset 0 0 14px rgba(91, 231, 255, 0.16);
	}

	.rune-icon {
		font-size: 13px;
	}

	.skill-tree-canvas {
		position: relative;
		padding: 6px 0;
	}

	.tree-panel {
		display: none;
	}

	.tree-panel.active {
		display: block;
	}

	.tree-stage {
		position: relative;
		width: 330px;
		height: 312px;
		margin: 0 auto;
	}

	.tree-svg {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}

	.skill-node {
		position: absolute;
		width: 46px;
		height: 46px;
		box-sizing: border-box;
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		transition: border-color 200ms ease, box-shadow 200ms ease;
	}

	.skill-node img {
		width: 26px;
		height: 26px;
		display: block;
	}

