---
import demoArticle from "./sharpe-ratio-demo.html?raw";
---

<div class="sharpe-demo">
	<Fragment set:html={demoArticle} />
</div>

<style>
	.sharpe-demo {
		padding: 0 0 var(--space-5);
	}

	.sharpe-demo :global(article) {
		font-family: "IBM Plex Sans", "Huninn", sans-serif;
	}

	/* The page background remains the shared SiteLayout treatment. */
	.sharpe-demo :global(.sharpe-hero),
	.sharpe-demo :global(.sharpe-highlight) {
		box-shadow: var(--glow-soft), inset 0 0 0 1px rgba(255, 255, 255, 0.02);
		position: relative;
		transition:
			transform var(--motion-base) var(--easing-standard),
			border-color var(--motion-base) var(--easing-standard),
			box-shadow var(--motion-base) var(--easing-standard),
			background var(--motion-base) var(--easing-standard);
	}

	.sharpe-demo :global(.sharpe-hero:hover),
	.sharpe-demo :global(.sharpe-hero:focus-within),
	.sharpe-demo :global(.sharpe-highlight:hover),
	.sharpe-demo :global(.sharpe-highlight:focus-within) {
		border-color: var(--border-strong) !important;
		box-shadow: var(--glow-strong), inset 0 0 0 1px rgba(255, 255, 255, 0.04);
		transform: translateY(-1px);
	}

	.sharpe-demo :global(a) {
		color: var(--accent);
	}

	.sharpe-demo :global(a:hover) {
		color: var(--text-bright);
	}

	@media (prefers-reduced-motion: reduce) {
		.sharpe-demo :global(.sharpe-hero),
		.sharpe-demo :global(.sharpe-highlight) {
			transition: none;
		}

		.sharpe-demo :global(.sharpe-hero:hover),
		.sharpe-demo :global(.sharpe-hero:focus-within),
		.sharpe-demo :global(.sharpe-highlight:hover),
		.sharpe-demo :global(.sharpe-highlight:focus-within) {
			transform: none;
		}
	}

	@media (max-width: 620px) {
		.sharpe-demo :global(.toc-nav) {
			grid-template-columns: 1fr !important;
		}
	}
</style>
