---
import type { Dictionary } from "../i18n/zh";
import { zh } from "../i18n/zh";
import { en } from "../i18n/en";

interface Props {
	currentPath?: string;
	dict?: Dictionary;
}

const { currentPath = "/", dict } = Astro.props;
const currentLocale = Astro.currentLocale || "zh";
const t = dict || (currentLocale === "en" ? en : zh);

const isEn = currentLocale === "en";

const rawLinks = [
	{ href: "/", label: t.nav.home },
	{ href: "/research", label: t.nav.research },
	{ href: "/projects", label: t.nav.projects },
	{ href: "/activities", label: t.nav.activities },
	{ href: "/about", label: t.nav.about },
];

const links = rawLinks.map((link) => ({
	...link,
	href: isEn ? (link.href === "/" ? "/en/" : `/en${link.href}`) : link.href,
}));

const normalizePath = (p: string) => {
	const stripped = p.replace(/^\/en(\/|$)/, "/");
	const trimmed = stripped.replace(/\/+$/, "");
	return trimmed === "" ? "/" : trimmed;
};

const isActive = (linkHref: string) => {
	const normCurrent = normalizePath(currentPath);
	const normLink = normalizePath(linkHref);

	if (normLink === "/") {
		return normCurrent === "/";
	}

	return (
		normCurrent === normLink ||
		normCurrent.startsWith(`${normLink}/`)
	);
};

const getSwitchPath = (path: string, locale: string) => {
	if (locale === "en") {
		const target = path.replace(/^\/en(\/|$)/, "/");
		return target || "/";
	} else {
		if (path === "/") return "/en/";
		return `/en${path.startsWith("/") ? path : `/${path}`}`;
	}
};

const switchPath = getSwitchPath(currentPath, currentLocale);
const switchLabel = t.langSwitch.label;
---

<nav aria-label="Primary" class="nav">
	<ul class="nav-list">
		{
			links.map((link) => {
				const active = isActive(link.href);

				return (
					<li>
						<a
							aria-current={active ? "page" : undefined}
							class:list={{ active }}
							href={link.href}
						>
							<span>{link.label}</span>
						</a>
					</li>
				);
			})
		}
		<li>
			<a href={switchPath} class="lang-switch" aria-label="Switch language">
				<span>{switchLabel}</span>
			</a>
		</li>
	</ul>
</nav>

<style>
	.nav {
		display: flex;
		justify-content: flex-end;
	}

	.nav-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.85rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	a {
		align-items: center;
		background: rgba(91, 231, 255, 0.04);
		border: 1px solid rgba(91, 231, 255, 0.12);
		border-radius: var(--radius-pill);
		color: var(--text-dim);
		display: inline-flex;
		font-family: var(--font-display);
		font-size: 0.8rem;
		letter-spacing: 0.08em;
		padding: 0.68rem 0.96rem;
		position: relative;
		text-decoration: none;
		text-transform: uppercase;
		transition:
			transform var(--motion-base) var(--easing-standard),
			border-color var(--motion-base) var(--easing-standard),
			box-shadow var(--motion-base) var(--easing-standard),
			color var(--motion-base) var(--easing-standard),
			background var(--motion-base) var(--easing-standard);
	}

	a:hover,
	a:focus-visible,
	a.active {
		background: rgba(91, 231, 255, 0.09);
		border-color: rgba(91, 231, 255, 0.34);
		box-shadow: 0 10px 26px rgba(91, 231, 255, 0.12);
		color: var(--accent);
		outline: none;
		transform: translateY(-1px);
	}

	@media (max-width: 640px) {
		.nav {
			justify-content: flex-start;
		}

		.nav-list {
			gap: 0.55rem 0.65rem;
		}

		a {
			padding: 0.54rem 0.78rem;
			font-size: 0.76rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		a {
			transition: none;
		}
	}
</style>
