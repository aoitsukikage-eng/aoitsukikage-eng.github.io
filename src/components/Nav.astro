---
const { currentPath = "/" } = Astro.props;

const links = [
	{ href: "/", label: "Home" },
	{ href: "/research", label: "Research" },
	{ href: "/projects", label: "Projects" },
	{ href: "/activities", label: "Activities" },
	{ href: "/about", label: "About" },
	{ href: "/about#contact", label: "Contact" },
];

const isActive = (href: string) => {
	if (href === "/") {
		return currentPath === "/";
	}

	return currentPath === href || currentPath.startsWith(`${href}/`);
};
---

<nav aria-label="Primary" class="nav">
	<ul class="nav-list">
		{
			links.map((link) => {
				const active = isActive(link.href);

				return (
					<li>
						<a
							aria-current={active ? "page" : undefined}
							class:list={{ active }}
							href={link.href}
						>
							<span>{link.label}</span>
						</a>
					</li>
				);
			})
		}
	</ul>
</nav>

<style>
	.nav {
		display: flex;
		justify-content: flex-end;
	}

	.nav-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.85rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	a {
		align-items: center;
		background: rgba(91, 231, 255, 0.04);
		border: 1px solid rgba(91, 231, 255, 0.12);
		border-radius: var(--radius-pill);
		color: var(--text-dim);
		display: inline-flex;
		font-family: var(--font-display);
		font-size: 0.8rem;
		letter-spacing: 0.08em;
		padding: 0.68rem 0.96rem;
		position: relative;
		text-decoration: none;
		text-transform: uppercase;
		transition:
			transform var(--motion-base) var(--easing-standard),
			border-color var(--motion-base) var(--easing-standard),
			box-shadow var(--motion-base) var(--easing-standard),
			color var(--motion-base) var(--easing-standard),
			background var(--motion-base) var(--easing-standard);
	}

	a:hover,
	a:focus-visible,
	a.active {
		background: rgba(91, 231, 255, 0.09);
		border-color: rgba(91, 231, 255, 0.34);
		box-shadow: 0 10px 26px rgba(91, 231, 255, 0.12);
		color: var(--accent);
		outline: none;
		transform: translateY(-1px);
	}

	@media (max-width: 640px) {
		.nav {
			justify-content: flex-start;
		}

		.nav-list {
			gap: 0.55rem 0.65rem;
		}

		a {
			padding: 0.54rem 0.78rem;
			font-size: 0.76rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		a {
			transition: none;
		}
	}
</style>
