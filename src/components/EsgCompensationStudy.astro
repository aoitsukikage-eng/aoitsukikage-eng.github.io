---
import studyArticle from "./esg-compensation-study.html?raw";
---

<div class="esg-study">
	<Fragment set:html={studyArticle} />
</div>

<style>
	.esg-study {
		padding: 0 0 var(--space-5);
	}

	.esg-study :global(article) {
		font-family: "IBM Plex Sans", "Huninn", sans-serif;
	}

	.esg-study :global(.esg-hero),
	.esg-study :global(.esg-highlight),
	.esg-study :global(.esg-figure) {
		box-shadow: var(--glow-soft), inset 0 0 0 1px rgba(255, 255, 255, 0.02);
		position: relative;
		transition:
			transform var(--motion-base) var(--easing-standard),
			border-color var(--motion-base) var(--easing-standard),
			box-shadow var(--motion-base) var(--easing-standard),
			background var(--motion-base) var(--easing-standard);
	}

	.esg-study :global(.esg-hero:hover),
	.esg-study :global(.esg-hero:focus-within),
	.esg-study :global(.esg-highlight:hover),
	.esg-study :global(.esg-highlight:focus-within),
	.esg-study :global(.esg-figure:hover),
	.esg-study :global(.esg-figure:focus-within) {
		border-color: var(--border-strong) !important;
		box-shadow: var(--glow-strong), inset 0 0 0 1px rgba(255, 255, 255, 0.04);
		transform: translateY(-1px);
	}

	.esg-study :global(a) {
		color: var(--accent);
	}

	.esg-study :global(a:hover) {
		color: var(--text-bright);
	}

	.esg-study :global(.esg-table-wrap) {
		overflow-x: auto;
	}

	/* The article and its sections carry an inline `display:grid`, so their
	   single column is auto-sized: any child wider than the measure stretches
	   every sibling with it. Pin the tracks to the reading measure first, then
	   let only the figures overflow, evenly on both sides. The viewport cap
	   retains a safe in-viewport figure width on narrow screens. */
	.esg-study :global(article),
	.esg-study :global(article > section) {
		grid-template-columns: minmax(0, 1fr);
	}

	.esg-study :global(.esg-figure) {
		width: min(66rem, calc(100vw - 2rem));
		justify-self: center;
	}

	@media (prefers-reduced-motion: reduce) {
		.esg-study :global(.esg-hero),
		.esg-study :global(.esg-highlight),
		.esg-study :global(.esg-figure) {
			transition: none;
		}

		.esg-study :global(.esg-hero:hover),
		.esg-study :global(.esg-hero:focus-within),
		.esg-study :global(.esg-highlight:hover),
		.esg-study :global(.esg-highlight:focus-within),
		.esg-study :global(.esg-figure:hover),
		.esg-study :global(.esg-figure:focus-within) {
			transform: none;
		}
	}

	@media (max-width: 620px) {
		.esg-study :global(.toc-nav) {
			grid-template-columns: 1fr !important;
		}

		.esg-study :global(.esg-metadata),
		.esg-study :global(.esg-highlights) {
			grid-template-columns: 1fr !important;
		}
	}
</style>
