---
import { getCollection } from "astro:content";
import SiteLayout from "../layouts/SiteLayout.astro";
import {
	formatActivityDate,
	getActivityPhotoCaption,
	getActivityTypeLabel,
	sortActivities,
} from "../lib/activities";

const activityEntries = sortActivities(await getCollection("activities"));
---

<SiteLayout
	title="Activities | Aoi Tsukikage Engineering"
	description="Activity route logging volunteer, talk, visit, and forum experiences with structured role, summary, and photo records."
	currentPath={Astro.url.pathname}
>
	<div class="page-stack">
		<section class="section-card section-shell" data-reveal id="activities-hero" style="--reveal-order: 0;">
			<p class="section-kicker">[SYSTEM]</p>
			<h1>Activities is a structured experience log, not a photo wall — real photos replace placeholder slots as each entry clears for public release.</h1>
			<div class="hud-divider" aria-hidden="true"></div>
			<p>
				Each entry keeps the experience framing first: organization, date, role,
				summary, and then either real public-safe photos or a placeholder slot
				for entries still awaiting a content pass.
			</p>
			<div class="meta-row">
				<span class="meta-chip">{activityEntries.length} activity log entries</span>
			</div>
			<div class="cta-row">
				<a class="cta-link" href="/research">Open Research Route</a>
				<a class="cta-link secondary" href="/projects">View Projects</a>
			</div>
		</section>

		<section class="activity-log" id="activities-log">
			{
				activityEntries.map((activity, index) => (
					<article
						class="section-card activity-entry"
						data-reveal
						style={`--reveal-order: ${index + 2};`}
					>
						<div class="activity-entry__header">
							<div class="meta-row">
								<span class="project-chip">{getActivityTypeLabel(activity.data.type)}</span>
								<span class="meta-chip">{activity.data.org}</span>
								<span class="meta-chip">{formatActivityDate(activity.data.date)}</span>
							</div>
							<h2>{activity.data.title}</h2>
						</div>

						<div class="hud-divider" aria-hidden="true"></div>

						<div class="activity-entry__body">
							<div class="activity-copy">
								<div class="detail-block">
									<h3 class="detail-title">Role Summary</h3>
									<p>{activity.data.role}</p>
								</div>
								<div class="detail-block">
									<h3 class="detail-title">Learning Capture</h3>
									<p>{activity.data.summary}</p>
								</div>
								<div class="meta-row">
									{
										activity.data.tags.map((tag) => (
											<span class="meta-chip">{tag.replaceAll("-", " ")}</span>
										))
									}
								</div>
							</div>

							<div class="activity-photos">
								{
									activity.data.photos.map((photo, photoIndex) =>
										typeof photo === "string" ? (
											<figure class="photo-slot">
												<div class="photo-frame" aria-hidden="true">
													<span>[PHOTO SLOT {photoIndex + 1}]</span>
												</div>
												<figcaption>
													{getActivityPhotoCaption(activity, photo, photoIndex)}
												</figcaption>
											</figure>
										) : (
											<figure class="photo-slot photo-slot--filled">
												<img alt={photo.alt} loading="lazy" src={photo.src} />
												<figcaption>{photo.caption}</figcaption>
											</figure>
										),
									)
								}
							</div>
						</div>
					</article>
				))
			}
		</section>
	</div>
</SiteLayout>

<style>
	.activity-log {
		display: grid;
		gap: var(--space-5);
	}

	.activity-entry {
		display: grid;
		gap: var(--space-4);
	}

	.activity-entry__header,
	.activity-copy {
		display: grid;
		gap: 0.9rem;
	}

	.activity-entry__body {
		align-items: start;
		display: grid;
		gap: 1.25rem;
		grid-template-columns: minmax(0, 1.05fr) minmax(18rem, 0.95fr);
	}

	.detail-block {
		background: rgba(91, 231, 255, 0.04);
		border: 1px solid rgba(91, 231, 255, 0.1);
		border-radius: 1rem;
		display: grid;
		gap: 0.7rem;
		padding: 1rem 1.05rem;
	}

	.detail-title {
		font-size: 0.9rem;
	}

	.activity-photos {
		display: grid;
		gap: 0.9rem;
	}

	.photo-slot {
		background: rgba(8, 18, 38, 0.62);
		border: 1px solid rgba(91, 231, 255, 0.1);
		border-radius: 1.05rem;
		display: grid;
		gap: 0.8rem;
		margin: 0;
		padding: 0.95rem;
	}

	.photo-frame {
		align-items: center;
		background:
			linear-gradient(135deg, rgba(91, 231, 255, 0.12), rgba(91, 231, 255, 0.02)),
			radial-gradient(circle at top right, rgba(124, 207, 255, 0.14), transparent 48%);
		border: 1px dashed rgba(91, 231, 255, 0.34);
		border-radius: 0.95rem;
		color: var(--accent-soft);
		display: grid;
		font-family: var(--font-display);
		letter-spacing: 0.08em;
		min-height: 8.8rem;
		place-items: center;
		text-align: center;
		text-transform: uppercase;
	}

	.photo-slot figcaption {
		color: var(--text-muted);
		font-size: 0.92rem;
		line-height: 1.66;
	}

	.photo-slot--filled img {
		border-radius: 0.95rem;
		display: block;
		height: auto;
		max-height: 22rem;
		object-fit: cover;
		width: 100%;
	}

	@media (max-width: 900px) {
		.activity-entry__body {
			grid-template-columns: 1fr;
		}
	}
</style>
