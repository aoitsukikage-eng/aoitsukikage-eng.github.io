---
import { getCollection, render } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { siteConfig } from "../../config/site";
import { getResearchEntries, getResearchGroup, RESEARCH_GROUPS, sortResearch } from "../../lib/research";

import { zh } from "../../i18n/zh";
import { en } from "../../i18n/en";

export async function getStaticPaths() {
	const entries = sortResearch(getResearchEntries(await getCollection("researchItems")));
	return entries.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const group = RESEARCH_GROUPS.find((item) => item.key === getResearchGroup(entry));
const isEsgStudy = entry.data.slug === "executive-compensation-esg-disclosure";
const isLegalStudy = entry.data.slug === "sinopac-sambo-overloan-governance";

const currentLocale = Astro.currentLocale ?? "zh";
const dict = currentLocale === "en" ? en : zh;
const isLocaleMatch = entry.data.lang === currentLocale;
const nativeUrl = entry.data.lang === "en" ? `/en/research/${entry.data.slug}/` : `/research/${entry.data.slug}/`;

const langName = currentLocale === "zh"
	? (entry.data.lang === "en" ? "英文" : "中文")
	: (entry.data.lang === "zh" ? "Traditional Chinese" : "English");
const notice = dict.contentFallback.notice.replace("{lang}", langName);
const viewLink = dict.contentFallback.viewLink.replace("{lang}", langName);
const backHubUrl = currentLocale === "en" ? "/en/research/" : "/research/";
---

<SiteLayout title={`${entry.data.title} | Research`} description={entry.data.summary} currentPath={Astro.url.pathname}>
	<article class="page-stack research-detail">
		<header class="section-card section-shell" data-reveal style="--reveal-order: 0;">
			<p class="section-kicker">[RESEARCH / {group?.label ?? "Brief"}]</p>
			<h1>{entry.data.title}</h1>
			<div class="hud-divider" aria-hidden="true"></div>
			<p class="lede">{entry.data.summary}</p>
			<div class="meta-row" aria-label="Research metadata">
				<span class="meta-chip">{entry.data.year}</span>
				{entry.data.tags.map((tag) => <span class="meta-chip">{tag}</span>)}
			</div>
		</header>

		{isLocaleMatch ? (
			<>
				<section class="section-shell section-plain" aria-labelledby="highlights-heading" data-reveal style="--reveal-order: 1;">
					<p class="section-kicker">[HIGHLIGHTS]</p>
					<h2 id="highlights-heading">At a glance</h2>
					<div class="hud-divider" aria-hidden="true"></div>
					<dl class="highlights-grid">
						{entry.data.highlights.map((highlight) => (
							<div><dt>{highlight.label}</dt><dd>{highlight.value}</dd>{highlight.detail && <p>{highlight.detail}</p>}</div>
						))}
					</dl>
				</section>

				<section class="section-shell section-plain" aria-labelledby="method-heading" data-reveal style="--reveal-order: 2;">
					<p class="section-kicker">[METHOD]</p>
					<h2 id="method-heading">How the brief was constructed</h2>
					<div class="hud-divider" aria-hidden="true"></div>
					<ol class="method-list">{entry.data.methods.map((method) => <li>{method}</li>)}</ol>
				</section>

				<section class="section-shell section-plain" aria-labelledby="findings-heading" data-reveal style="--reveal-order: 3;">
					<p class="section-kicker">[FINDINGS]</p>
					<h2 id="findings-heading">What the source-supported analysis indicates</h2>
					<div class="hud-divider" aria-hidden="true"></div>
					<ul class="finding-list">{entry.data.findings.map((finding) => <li>{finding}</li>)}</ul>
				</section>

				{(entry.data.visuals?.length || entry.data.type !== "quantitative") && (
				<section class="section-shell section-plain" aria-labelledby="visuals-heading" data-reveal style="--reveal-order: 4;">
					<p class="section-kicker">[VISUAL MODEL]</p>
					<h2 id="visuals-heading">{entry.data.type === "quantitative" ? "Author-created charts and framework" : "Native reading framework"}</h2>
					<div class="hud-divider" aria-hidden="true"></div>
					{entry.data.visuals?.length ? <div class="visual-grid">
						{entry.data.visuals.map((visual) => <figure><img src={visual.src} alt={visual.alt} loading="lazy" /><figcaption><span>{visual.caption}</span><span class="visual-rights">© 2026 {siteConfig.name} · <a href={Astro.url.href}>{Astro.url.href}</a></span></figcaption></figure>)}
					</div> : entry.data.type === "comparative" ? <div class="comparison-model" aria-label="Four-company disclosure comparison framework">
						<div><span>01</span><strong>Company disclosures</strong><p>Annual reports and sustainability reports</p></div>
						<div><span>02</span><strong>Course questions</strong><p>ESG indicators and compensation weighting</p></div>
						<div><span>03</span><strong>Author extension</strong><p>Cross-industry and cross-document comparison</p></div>
					</div> : <ol class="narrative-timeline" aria-label="Narrative research framework">
						<li><span>01</span><div><strong>Context</strong><p>{isLegalStudy ? "Reconstruct the source-reported case setting and relationships." : "Place the case in its local community and ageing-society context."}</p></div></li>
						<li><span>02</span><div><strong>Framework</strong><p>{isLegalStudy ? "Read administrative, criminal, and internal-control layers separately." : "Read financial accessibility through service situations and relationships."}</p></div></li>
						<li><span>03</span><div><strong>Boundary</strong><p>Publish a text-based, source-traceable brief without redistributing protected source material.</p></div></li>
					</ol>}
				</section>
				)}

				{isEsgStudy && <section class="section-card section-shell distinction" aria-labelledby="assignment-boundary-heading" data-reveal style="--reveal-order: 5;">
					<p class="section-kicker">[SCOPE BOUNDARY]</p>
					<h2 id="assignment-boundary-heading">Teacher requirements and author extension</h2>
					<div class="hud-divider" aria-hidden="true"></div>
					<p><strong>Teacher requirements:</strong> identify the ESG performance indicators used and their weighting in executive compensation evaluation.</p>
					<p><strong>Author extension:</strong> the four-company cross-industry sample, annual-report/sustainability-report cross-reading, disclosure-consistency comparison, clawback, and governance observations.</p>
				</section>}

				<section class="section-shell section-plain" aria-labelledby="reflection-heading" data-reveal style={`--reveal-order: ${isEsgStudy ? 6 : 5};`}>
					<p class="section-kicker">[REFLECTION & LIMITS]</p>
					<h2 id="reflection-heading">Public-version boundary</h2>
					<div class="hud-divider" aria-hidden="true"></div>
					<p>{entry.data.reflection}</p>
					{isLegalStudy && <p class="legal-note"><strong>Research-time notice:</strong> This page reflects publicly available material at the report-writing time, is not legal advice, and does not claim the latest or final judicial outcome.</p>}
				</section>

				<section class="section-shell section-plain source-brief" aria-labelledby="source-brief-heading">
					<p class="section-kicker">[SOURCE-TRACEABLE BRIEF]</p>
					<h2 id="source-brief-heading">Research context and publication boundary</h2>
					<div class="hud-divider" aria-hidden="true"></div>
					<Content />
				</section>

				<section class="section-shell section-plain publication-rights" aria-labelledby="publication-rights-heading" data-reveal style="--reveal-order: 8;">
					<p class="section-kicker">[PUBLICATION RIGHTS]</p>
					<h2 id="publication-rights-heading">Citation and rights</h2>
					<div class="hud-divider" aria-hidden="true"></div>
					<p><strong>{siteConfig.name}</strong> · © 2026 · All Rights Reserved</p>
					<p>Fixed page URL: <a href={Astro.url.href}>{Astro.url.href}</a></p>
					<p>Reasonable quotation is welcome when it clearly identifies the author and this source page.</p>
				</section>
			</>
		) : (
			<section class="section-card section-shell" data-reveal style="--reveal-order: 1;">
				<p class="section-kicker">[LOCALE NOTICE]</p>
				<p>{notice}</p>
				<div class="cta-row">
					<a class="cta-link" href={nativeUrl}>{viewLink}</a>
				</div>
			</section>
		)}
		<p class="back-link"><a class="cta-link secondary" href={backHubUrl}>Back to Research Hub</a></p>
	</article>
</SiteLayout>

<style>
	.lede { color: var(--text-dim); font-size: clamp(1.05rem, 2vw, 1.2rem); }
	.highlights-grid { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); margin: 0; }
	.highlights-grid div { background: rgba(8, 18, 38, .48); border: 1px solid rgba(91, 231, 255, .12); border-radius: 1rem; padding: 1rem; }
	.highlights-grid dt { color: var(--accent); font-family: var(--font-display); font-size: .78rem; letter-spacing: .08em; text-transform: uppercase; }
	.highlights-grid dd { color: var(--text-bright); font-size: 1.05rem; margin: .55rem 0 0; }
	.highlights-grid p { color: var(--text-muted); margin-bottom: 0; }
	.method-list, .finding-list { display: grid; gap: 1rem; margin: 0; padding-left: 1.4rem; }
	.method-list li, .finding-list li { padding-left: .35rem; }
	.distinction { border-color: rgba(91, 231, 255, .3); }
	.legal-note { border-left: 3px solid var(--accent); color: var(--text-dim); padding-left: 1rem; }
	.source-brief :global(h2) { font-size: 1.25rem; }
	.source-brief :global(h3) { font-size: 1.08rem; }
	.source-brief :global(li) { margin: .5rem 0; }
	.source-brief :global(table) { border-collapse: collapse; display: block; margin: 1.25rem 0; max-width: 100%; overflow-x: auto; width: 100%; }
	.source-brief :global(th), .source-brief :global(td) { border: 1px solid rgba(91, 231, 255, .18); padding: .65rem .75rem; text-align: left; white-space: nowrap; }
	.source-brief :global(th) { background: rgba(91, 231, 255, .1); color: var(--text-bright); font-family: var(--font-display); font-size: .76rem; letter-spacing: .04em; }
	.source-brief :global(td) { color: var(--text-dim); }
	.source-brief :global(.frontier-figure) { align-items: center; display: grid; gap: 1.5rem; grid-template-columns: minmax(0, 1.22fr) minmax(0, 1fr); margin: 1.25rem 0; }
	.source-brief :global(.frontier-figure table) { margin: 0; }
	.source-brief :global(.frontier-figure img) { border: 1px solid rgba(91, 231, 255, .12); border-radius: 1rem; display: block; height: auto; width: 100%; }
	@media (max-width: 760px) { .source-brief :global(.frontier-figure) { grid-template-columns: 1fr; } }
	.visual-grid { display: grid; gap: var(--space-4); grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr)); }
	.visual-grid figure { background: rgba(8, 18, 38, .48); border: 1px solid rgba(91, 231, 255, .12); border-radius: 1rem; margin: 0; overflow: hidden; }
	.visual-grid img { display: block; height: auto; max-width: 100%; width: 100%; }
	.visual-grid figcaption { color: var(--text-muted); display: grid; font-size: .9rem; gap: .5rem; padding: .85rem 1rem; }
	.visual-rights { color: var(--accent); font-size: .78rem; letter-spacing: .03em; }
	.visual-rights a { color: inherit; overflow-wrap: anywhere; }
	.publication-rights { border-left: 3px solid rgba(91, 231, 255, .45); }
	.publication-rights p { color: var(--text-muted); margin-bottom: .65rem; }
	.publication-rights p:last-child { margin-bottom: 0; }
	.publication-rights a { overflow-wrap: anywhere; }
	.comparison-model { display: grid; gap: 1rem; grid-template-columns: repeat(3, minmax(0, 1fr)); }
	.comparison-model div, .narrative-timeline li { background: rgba(8, 18, 38, .48); border: 1px solid rgba(91, 231, 255, .12); border-radius: 1rem; padding: 1rem; }
	.comparison-model span, .narrative-timeline span { color: var(--accent); font-family: var(--font-display); font-size: .8rem; letter-spacing: .1em; }
	.comparison-model strong, .narrative-timeline strong { color: var(--text-bright); display: block; margin-top: .45rem; }
	.comparison-model p, .narrative-timeline p { color: var(--text-muted); margin-bottom: 0; }
	.narrative-timeline { display: grid; gap: 1rem; list-style: none; margin: 0; padding: 0; }
	.narrative-timeline li { display: grid; gap: .45rem; grid-template-columns: 2.5rem 1fr; }
	@media (max-width: 680px) { .comparison-model { grid-template-columns: 1fr; } }
	.back-link { margin: 0; }
</style>
