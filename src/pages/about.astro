---
import SiteLayout from "../layouts/SiteLayout.astro";
import { siteConfig } from "../config/site";
---

<SiteLayout
	title={`About | ${siteConfig.name}`}
	description={`${siteConfig.name} is an NTPU Finance Student interested in quantitative finance, Python automation, and FinTech.`}
	currentPath={Astro.url.pathname}
>
	<div class="page-stack">
		<section class="section-card section-shell hero-card" data-reveal id="about" style="--reveal-order: 0;">
			<p class="section-kicker">[PROFILE]</p>
			<h1>{siteConfig.name}</h1>
			<div class="hud-divider" aria-hidden="true"></div>
			<p class="summary">
				I didn't come from a CS background. I learned to build things because a
				job needed it.
			</p>
			<div class="hero-actions">
				<div class="cta-row">
					<a class="cta-link primary-cta" href="#contact">
						<span>Contact Me</span>
						<span class="cta-icon" aria-hidden="true">↓</span>
					</a>
					<a class="cta-link secondary" href="/projects">View Projects</a>
				</div>
				<p class="hero-hint">
					<span class="hint-symbol" aria-hidden="true">▸</span>
					Direct contact details & social profiles available on this page below.
				</p>
			</div>
		</section>

		<section class="section-shell section-plain" data-reveal id="journey" style="--reveal-order: 1;">
			<p class="section-kicker">[JOURNEY]</p>
			<h2>How I got here</h2>
			<div class="hud-divider" aria-hidden="true"></div>
			<p>
				When I started as a research assistant at NTPU's Center for Corporate
				Sustainability, the work was reading corporate sustainability reports by
				hand, one at a time. With some encouragement from my supervisors, I
				picked up Python to automate the parts that didn't need to be manual. It
				stuck — I started building my own tools for coursework too, just because
				I wanted the practice, not because anyone asked.
			</p>
			<p>
				That habit shaped how I build now: I start from what a task actually
				needs, not from what a "proper" architecture would look like. It's less
				elegant on paper, but it ships, and it's easier for the next person to
				maintain.
			</p>
			<p>
				From there it snowballed — I designed and shipped an ESG advisory
				chatbot end-to-end for the center, talked my way into a GDG NTPU ×
				TPIsoftware industry project doing chatbot front-end and UI/UX, and more
				recently found myself on the other side of it, volunteering to teach
				elementary school kids how to use AI tools.
			</p>
			<p>I'm still mostly self-taught, still mostly figuring it out as I build.</p>
		</section>

		<section class="section-card section-shell contact-section" data-reveal id="contact" style="--reveal-order: 2;">
			<p class="section-kicker">[CONTACT]</p>
			<h2>Get in Touch</h2>
			<div class="hud-divider" aria-hidden="true"></div>
			<p class="contact-lead">
				Choose a direct channel below to initiate communication or explore professional profiles.
			</p>

			<div class="contact-destinations">
				<a
					class="contact-card contact-card--primary"
					href={`mailto:${siteConfig.email}`}
				>
					<div class="contact-card__badge-row">
						<span class="contact-tag primary-tag">[PRIMARY DIRECT CHANNEL]</span>
					</div>
					<div class="contact-card__main">
						<span class="contact-card__label">Email</span>
						<span class="contact-card__purpose">Start a direct email conversation.</span>
						<span class="contact-card__detail">{siteConfig.email}</span>
					</div>
					<span class="contact-card__action primary-action">
						<span>Compose Email</span>
						<span class="action-icon" aria-hidden="true">✉</span>
					</span>
				</a>

				<div class="contact-secondary-grid">
					<a
						class="contact-card contact-card--secondary"
						href={siteConfig.socials.github}
						rel="noopener noreferrer"
						target="_blank"
					>
						<div class="contact-card__badge-row">
							<span class="contact-tag">[PROFILE]</span>
						</div>
						<div class="contact-card__main">
							<span class="contact-card__label">GitHub</span>
							<span class="contact-card__purpose">Explore public repositories and source code.</span>
						</div>
						<span class="contact-card__action">
							<span>Open GitHub</span>
							<span class="action-icon" aria-hidden="true">↗</span>
						</span>
					</a>

					<a
						class="contact-card contact-card--secondary"
						href={siteConfig.socials.linkedin}
						rel="noopener noreferrer"
						target="_blank"
					>
						<div class="contact-card__badge-row">
							<span class="contact-tag">[PROFILE]</span>
						</div>
						<div class="contact-card__main">
							<span class="contact-card__label">LinkedIn</span>
							<span class="contact-card__purpose">Connect professionally on LinkedIn.</span>
						</div>
						<span class="contact-card__action">
							<span>Open LinkedIn</span>
							<span class="action-icon" aria-hidden="true">↗</span>
						</span>
					</a>
				</div>
			</div>
		</section>
	</div>
</SiteLayout>

<style>
	.summary {
		font-size: clamp(1.08rem, 2vw, 1.3rem);
		max-width: 42rem;
	}

	.hero-actions {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.primary-cta {
		background: linear-gradient(180deg, rgba(91, 231, 255, 0.22), rgba(12, 36, 68, 0.94));
		border-color: rgba(91, 231, 255, 0.48);
		box-shadow: 0 0 20px rgba(91, 231, 255, 0.16), inset 0 0 0 1px rgba(91, 231, 255, 0.24);
		color: var(--text-bright);
		font-weight: 600;
	}

	.primary-cta:hover,
	.primary-cta:focus-visible {
		background: linear-gradient(180deg, rgba(91, 231, 255, 0.32), rgba(16, 48, 92, 0.98));
		border-color: rgba(91, 231, 255, 0.75);
		box-shadow: 0 0 28px rgba(91, 231, 255, 0.28), 0 10px 24px rgba(5, 11, 23, 0.6);
		color: #ffffff;
	}

	.cta-icon {
		display: inline-block;
		font-size: 0.9rem;
		margin-left: 0.35rem;
		transition: transform var(--motion-base) var(--easing-standard);
	}

	.primary-cta:hover .cta-icon,
	.primary-cta:focus-visible .cta-icon {
		transform: translateY(2px);
	}

	.hero-hint {
		color: var(--text-muted);
		font-size: 0.82rem;
		letter-spacing: 0.02em;
		margin: 0;
	}

	.hint-symbol {
		color: var(--accent);
		margin-right: 0.25rem;
	}

	:global(.section-shell) {
		scroll-margin-top: 5.5rem;
	}

	.contact-lead {
		font-size: clamp(1rem, 1.6vw, 1.12rem);
		max-width: 40rem;
	}

	.contact-destinations {
		display: grid;
		gap: 1.25rem;
	}

	.contact-card {
		background: rgba(8, 18, 38, 0.52);
		border: 1px solid rgba(91, 231, 255, 0.14);
		border-radius: 1.25rem;
		color: inherit;
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
		padding: 1.35rem 1.4rem;
		position: relative;
		text-decoration: none;
		transition:
			border-color var(--motion-base) var(--easing-standard),
			box-shadow var(--motion-base) var(--easing-standard),
			transform var(--motion-base) var(--easing-standard),
			background var(--motion-base) var(--easing-standard);
	}

	.contact-card--primary {
		background:
			linear-gradient(135deg, rgba(14, 34, 64, 0.75), rgba(8, 20, 44, 0.85)),
			radial-gradient(circle at top right, rgba(91, 231, 255, 0.12), transparent 60%);
		border: 1px solid rgba(91, 231, 255, 0.32);
		box-shadow: 0 12px 32px rgba(91, 231, 255, 0.1), inset 0 0 0 1px rgba(91, 231, 255, 0.08);
		padding: 1.6rem 1.7rem;
	}

	.contact-card--primary:hover,
	.contact-card--primary:focus-visible {
		background:
			linear-gradient(135deg, rgba(18, 44, 82, 0.85), rgba(10, 26, 56, 0.92)),
			radial-gradient(circle at top right, rgba(91, 231, 255, 0.2), transparent 60%);
		border-color: rgba(91, 231, 255, 0.65);
		box-shadow: 0 16px 40px rgba(91, 231, 255, 0.2), inset 0 0 0 1px rgba(91, 231, 255, 0.18);
		transform: translateY(-2px);
	}

	.contact-card--secondary:hover,
	.contact-card--secondary:focus-visible {
		background: rgba(12, 26, 52, 0.68);
		border-color: rgba(91, 231, 255, 0.38);
		box-shadow: 0 12px 30px rgba(91, 231, 255, 0.12);
		transform: translateY(-2px);
	}

	.contact-secondary-grid {
		display: grid;
		gap: 1.25rem;
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}

	.contact-badge-row {
		display: flex;
	}

	.contact-tag {
		background: rgba(91, 231, 255, 0.06);
		border: 1px solid rgba(91, 231, 255, 0.16);
		border-radius: var(--radius-pill);
		color: var(--text-dim);
		font-family: var(--font-display);
		font-size: 0.68rem;
		letter-spacing: 0.12em;
		padding: 0.22rem 0.58rem;
		text-transform: uppercase;
		width: fit-content;
	}

	.primary-tag {
		background: rgba(91, 231, 255, 0.14);
		border-color: rgba(91, 231, 255, 0.34);
		color: var(--accent);
	}

	.contact-card__main {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}

	.contact-card__label {
		color: var(--text-bright);
		font-family: var(--font-display);
		font-size: 1.15rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.contact-card--primary .contact-card__label {
		font-size: 1.35rem;
	}

	.contact-card__purpose {
		color: var(--text-dim);
		font-size: 0.94rem;
	}

	.contact-card__detail {
		color: var(--accent);
		font-family: var(--font-display);
		font-size: 0.88rem;
		letter-spacing: 0.04em;
		margin-top: 0.2rem;
		word-break: break-all;
	}

	.contact-card__action {
		align-items: center;
		color: var(--text-dim);
		display: inline-flex;
		font-family: var(--font-display);
		font-size: 0.78rem;
		gap: 0.4rem;
		letter-spacing: 0.08em;
		margin-top: auto;
		text-transform: uppercase;
	}

	.primary-action {
		background: rgba(91, 231, 255, 0.1);
		border: 1px solid rgba(91, 231, 255, 0.25);
		border-radius: var(--radius-pill);
		color: var(--accent);
		padding: 0.5rem 0.9rem;
		width: fit-content;
	}

	.contact-card--primary:hover .primary-action,
	.contact-card--primary:focus-visible .primary-action {
		background: rgba(91, 231, 255, 0.2);
		border-color: rgba(91, 231, 255, 0.5);
		color: #ffffff;
	}

	.action-icon {
		font-size: 0.9rem;
	}

	@media (max-width: 760px) {
		.contact-secondary-grid {
			grid-template-columns: 1fr;
		}

		.contact-card--primary {
			padding: 1.35rem 1.4rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.contact-card,
		.contact-card--primary,
		.cta-icon {
			transition: none;
		}

		.contact-card:hover,
		.contact-card:focus-visible,
		.contact-card--primary:hover,
		.contact-card--primary:focus-visible,
		.primary-cta:hover .cta-icon,
		.primary-cta:focus-visible .cta-icon {
			transform: none;
		}
	}
</style>
