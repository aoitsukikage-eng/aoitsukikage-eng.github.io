---
import { getCollection } from "astro:content";
import SiteLayout from "../layouts/SiteLayout.astro";
import {
	getStatusLabel,
	getTrackLabel,
	getVisibilityLabel,
	getVisibilityNote,
	isPlaceholderProject,
	sortProjects,
} from "../lib/projects";

import { zh } from "../i18n/zh";
import { en } from "../i18n/en";

const currentLocale = Astro.currentLocale ?? "zh";
const dict = currentLocale === "en" ? en : zh;

const projectEntries = sortProjects(await getCollection("projectCases"));
const totalProjects = projectEntries.length;
const featuredCount = projectEntries.filter((project) => project.data.featured).length;
const placeholderCount = projectEntries.filter((project) =>
	isPlaceholderProject(project),
).length;

function getFallbackText(entryLang: "zh" | "en") {
	const langName = currentLocale === "zh"
		? (entryLang === "en" ? "英文" : "中文")
		: (entryLang === "zh" ? "Traditional Chinese" : "English");
	return {
		notice: dict.contentFallback.notice.replace("{lang}", langName),
		viewLink: dict.contentFallback.viewLink.replace("{lang}", langName),
	};
}
---

<SiteLayout
	title="Projects | Aoi Tsukikage Engineering"
	description="Data-driven projects hub with placeholder-safe visibility handling."
	currentPath={Astro.url.pathname}
>
	<div class="page-stack">
		<section class="section-card section-shell" data-reveal id="projects-hero" style="--reveal-order: 0;">
			<p class="section-kicker">[SYSTEM]</p>
			<h1>Projects Hub renders directly from the portfolio collection without hardcoded cards.</h1>
			<div class="hud-divider" aria-hidden="true"></div>
			<p>
				Visibility and placeholder rules keep unpublished work on a public-safe layer
				as every entry renders directly from the collection.
			</p>
			<div class="meta-row">
				<span class="meta-chip">{totalProjects} total entries</span>
				<span class="meta-chip">{featuredCount} featured flag</span>
				<span class="meta-chip">{placeholderCount} placeholder-safe</span>
			</div>
			<div class="cta-row">
				<a class="cta-link" href={currentLocale === "en" ? "/en/about#contact" : "/about#contact"}>Contact</a>
				<a class="cta-link secondary" href={currentLocale === "en" ? "/en/" : "/"}>Back Home</a>
			</div>
		</section>

		<section class="section-shell section-plain" data-reveal id="projects-grid" style="--reveal-order: 2;">
			<p class="section-kicker">[SYSTEM]</p>
			<h2>Collection-backed project cards with placeholder-safe summaries.</h2>
			<div class="hud-divider" aria-hidden="true"></div>
			<div class="projects-grid" data-project-grid>
				{
					projectEntries.map((project) => {
						const placeholder = isPlaceholderProject(project);
						const isLocaleMatch = project.data.lang === currentLocale;
						const nativeUrl = project.data.lang === "en" ? `/en/projects/${project.data.slug}/` : `/projects/${project.data.slug}/`;
						const { notice, viewLink } = getFallbackText(project.data.lang);

						return (
							<article
								class:list={{
									"project-card": true,
									"project-card--placeholder": placeholder,
								}}
								data-reveal
								data-placeholder={placeholder ? "true" : "false"}
								style="--reveal-order: 3;"
							>
								<div class="project-card__top">
									<div class="meta-row">
										<span class="project-chip">{getTrackLabel(project.data.track)}</span>
										<span
											class:list={{
												"project-chip": true,
												"project-status": true,
												"is-active": project.data.status === "active",
												"is-ongoing": project.data.status === "ongoing",
											}}
										>
											{getStatusLabel(project.data.status)}
										</span>
										<span class="project-chip project-chip--visibility">
											{
												project.data.visibility === "confidential" && (
													<svg
														aria-hidden="true"
														class="lock-icon"
														viewBox="0 0 24 24"
													>
														<path
															d="M7 10V7a5 5 0 0 1 10 0v3"
															fill="none"
															stroke="currentColor"
															stroke-linecap="round"
															stroke-linejoin="round"
															stroke-width="1.8"
														></path>
														<rect
															fill="none"
															height="10"
															rx="2"
															stroke="currentColor"
															stroke-width="1.8"
															width="14"
															x="5"
															y="10"
														></rect>
													</svg>
												)
											}
											{getVisibilityLabel(project.data.visibility)}
										</span>
										{
											placeholder && (
												<span class="project-chip project-chip--placeholder">
													Placeholder
												</span>
											)
										}
									</div>
									<h3>
										<a href={nativeUrl}>{project.data.title}</a>
									</h3>
									<p>{isLocaleMatch ? project.data.summary : notice}</p>
								</div>

								<div class="meta-row">
									{
										project.data.domain.map((domain) => (
											<span class="meta-chip">{domain.replaceAll("_", " ")}</span>
										))
									}
								</div>

								{isLocaleMatch ? (
									<>
										<div class="project-card__body">
											<p class="project-note">{getVisibilityNote(project)}</p>
											{
												placeholder && (
													<div class="placeholder-block">
														<p><strong>Team Role:</strong> {project.data.teamRole}</p>
														<p><strong>Background:</strong> {project.data.background}</p>
													</div>
												)
											}
										</div>

										<div class="cta-row">
											<a class="cta-link" href={nativeUrl}>Open Detail</a>
											{
												project.data.links?.repo && project.data.visibility === "public" && (
													<a
														class="cta-link secondary"
														href={project.data.links.repo}
														rel="noreferrer"
														target="_blank"
													>
														Repo
													</a>
												)
											}
											{
												project.data.links?.demo && project.data.visibility !== "confidential" && (
													<a
														class="cta-link secondary"
														href={project.data.links.demo}
														rel="noreferrer"
														target="_blank"
													>
														Demo
													</a>
												)
											}
										</div>
									</>
								) : (
									<div class="cta-row">
										<a class="cta-link" href={nativeUrl}>{viewLink}</a>
									</div>
								)}
							</article>
						);
					})
				}
			</div>
		</section>
	</div>
</SiteLayout>

<style>
	.projects-grid {
		display: grid;
		gap: var(--space-4);
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}

	.project-card--placeholder {
		border-style: dashed;
	}

	.project-card h3 a {
		color: var(--text-bright);
		text-decoration: none;
	}

	.project-card h3 a:hover,
	.project-card h3 a:focus-visible {
		color: var(--accent);
		outline: none;
	}

	.project-card__top,
	.project-card__body,
	.placeholder-block {
		display: grid;
		gap: 0.95rem;
	}

	.project-chip {
		backdrop-filter: blur(8px);
	}

	.project-status.is-active {
		background: var(--status-active-bg);
		border-color: var(--status-active-border);
		color: var(--status-active-text);
	}

	.project-status.is-ongoing {
		background: var(--status-ongoing-bg);
		border-color: var(--status-ongoing-border);
		color: var(--status-ongoing-text);
	}

	.project-chip--visibility {
		background: var(--status-confidential-bg);
		border-color: var(--status-confidential-border);
		color: rgba(244, 251, 255, 0.88);
	}

	.project-chip--placeholder {
		border-style: dashed;
	}

	.lock-icon {
		height: 0.9rem;
		width: 0.9rem;
	}

	.project-note {
		color: var(--text-muted);
	}

	.placeholder-block {
		background: rgba(91, 231, 255, 0.04);
		border: 1px solid rgba(91, 231, 255, 0.1);
		border-radius: 1rem;
		padding: 1rem;
	}

	@media (max-width: 900px) {
		.projects-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
