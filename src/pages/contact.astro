---
const currentLocale = Astro.currentLocale ?? "zh";
const destination = currentLocale === "en" ? "/en/about#contact" : "/about#contact";
---

<!doctype html>
<html lang={currentLocale}>
	<head>
		<meta charset="utf-8" />
		<meta http-equiv="refresh" content={`0; url=${destination}`} />
		<meta name="viewport" content="width=device-width" />
		<title>Contact moved</title>
	</head>
	<body>
		<main>
			<h1>Contact has moved</h1>
			<p><a href={destination}>Continue to the Contact section</a>.</p>
		</main>
	</body>
</html>
