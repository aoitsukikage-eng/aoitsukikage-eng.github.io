---
import SiteLayout from "../layouts/SiteLayout.astro";

const typingLines = [
	"[SYSTEM] PORTFOLIO SHELL LOADED",
	"[CLASS] PLACEHOLDER CONTENT LAYER",
	"[MISSION] SOLO UI VISUAL PASS ONLINE",
];

const quoteLines = [
	"Yesterday is history, tomorrow is a mystery,",
	"but today is a gift. That is why it is called the present.",
];

let quoteCharIndex = 0;
const quoteRows = quoteLines.map((line, lineIndex) => ({
	lineIndex,
	characters: Array.from(line).map((character) => ({
		character,
		index: quoteCharIndex++,
	})),
}),
);
---

<SiteLayout
	title="Aoi Tsukikage Engineering"
	description="Solo Leveling inspired portfolio shell with native HUD interface, animated mission cards, and interactive quote treatment."
	currentPath={Astro.url.pathname}
>
	<div class="page-stack">
		<section class="quote-shell section-card" data-quote-frame data-reveal id="home-quote" style="--reveal-order: 0;">
			<p class="section-kicker quote-kicker">[SYSTEM]</p>
			<div class="quote-surface">
				<div class="quote-halo" aria-hidden="true"></div>
				<div class="quote-shimmer" aria-hidden="true"></div>
				<p class="sr-only">
					Yesterday is history, tomorrow is a mystery, but today is a gift. That is why it is called the present.
				</p>
				<div aria-hidden="true" class="quote-lines">
					{
						quoteRows.map(({ lineIndex, characters }) => (
							<p class="quote-line" style={`--line-index: ${lineIndex};`}>
								{
									characters.map(({ character, index }) => (
										<span
											class:list={{
												"quote-char": true,
												"is-space": character === " ",
											}}
											style={`--char-index: ${index};`}
										>
											{character === " " ? "\u00A0" : character}
										</span>
									))
								}
							</p>
						))
					}
				</div>
				<div class="quote-underline" aria-hidden="true"></div>
			</div>
		</section>

		<section class="hero-shell section-card" data-reveal id="home-hero" style="--reveal-order: 0;">
			<div class="hero-copy">
				<p class="section-kicker">[SYSTEM]</p>
				<h1 class="hero-title">A placeholder-safe portfolio shell shaped with calm, high-tech precision.</h1>
				<div class="hud-divider" aria-hidden="true"></div>
				<p class="summary">The content stays intentionally generic while the interface makes room for it to breathe.</p>
				<div class="meta-row">
					<span class="meta-chip">Solo UI Pass</span>
					<span class="meta-chip">Placeholder Safe</span>
				</div>
				<div class="cta-row">
					<a class="cta-link" href="/projects">View Projects</a>
					<a class="cta-link secondary" href="/contact">Contact</a>
				</div>
			</div>

			<div class="hero-stack">
				<aside class="hero-terminal" data-reveal style="--reveal-order: 1;">
					<div class="hero-terminal__screen" data-system-typing>
						{
							typingLines.map((line) => (
								<p class="typing-line is-complete" data-typing-line>{line}</p>
							))
						}
					</div>
				</aside>
			</div>
		</section>

		<section class="section-shell section-plain" data-reveal id="home-intro" style="--reveal-order: 2;">
			<p class="section-kicker">[SYSTEM]</p>
			<h2>Intro section placeholder now sits inside the same mission HUD language as the rest of the site.</h2>
			<div class="hud-divider" aria-hidden="true"></div>
			<p>
				Placeholder copy still defines the homepage overview, but the information
				hierarchy now reads like a unified system surface instead of isolated cards.
			</p>
		</section>

		<section class="section-shell section-plain" data-reveal id="home-focus-areas" style="--reveal-order: 3;">
			<p class="section-kicker">[SYSTEM]</p>
			<h2>Focus areas remain placeholders while the card treatment upgrades to brighter tactical panels.</h2>
			<div class="hud-divider" aria-hidden="true"></div>
			<div class="section-grid">
				<article class="focus-card" data-reveal style="--reveal-order: 4;">
					<h3>Placeholder focus area one</h3>
					<p>Reserved for short summary text and one future directional cue.</p>
				</article>
				<article class="focus-card" data-reveal style="--reveal-order: 5;">
					<h3>Placeholder focus area two</h3>
					<p>Reserved for short summary text and one future directional cue.</p>
				</article>
			</div>
		</section>

		<section class="section-shell section-plain" data-reveal id="home-featured-pointer" style="--reveal-order: 4;">
			<p class="section-kicker">[SYSTEM]</p>
			<h2>Featured pointer section keeps a clean route into Projects without changing the P4 data flow.</h2>
			<div class="hud-divider" aria-hidden="true"></div>
			<p>
				Only the pointer structure exists here. Project taxonomy and detail-page logic
				continue to stay collection-backed and untouched.
			</p>
			<div class="cta-row">
				<a class="cta-link" href="/projects">Open Projects Hub</a>
			</div>
		</section>

		<section class="section-card section-shell" data-reveal id="home-cta" style="--reveal-order: 5;">
			<p class="section-kicker">[SYSTEM]</p>
			<h2>Final CTA band exits the homepage with the same active system framing.</h2>
			<div class="hud-divider" aria-hidden="true"></div>
			<p>Placeholder CTA copy stays generic while the visual layer now feels deliberate and fully themed.</p>
			<div class="cta-row">
				<a class="cta-link" href="/about">Read About</a>
				<a class="cta-link secondary" href="/contact">Start Contact Route</a>
			</div>
		</section>
	</div>
</SiteLayout>

<style>
	.hero-shell {
		align-items: start;
		display: grid;
		gap: var(--space-6);
		grid-template-columns: minmax(0, 1.55fr) minmax(16rem, 0.8fr);
		padding: var(--panel-padding-lg);
	}

	.quote-shell {
		isolation: isolate;
		overflow: visible;
		padding: clamp(2.2rem, 4vw, 3.35rem);
		text-align: center;
		transform:
			perspective(1400px) rotateX(var(--quote-rotate-x, 0deg))
			rotateY(var(--quote-rotate-y, 0deg))
			translate3d(0, 0, 0);
		transform-style: preserve-3d;
		transition: transform var(--motion-base) var(--easing-standard);
	}

	.quote-shell:hover,
	.quote-shell:focus-within {
		transform:
			perspective(1400px) rotateX(var(--quote-rotate-x, 0deg))
			rotateY(var(--quote-rotate-y, 0deg))
			translate3d(0, -1px, 0);
	}

	.hero-copy,
	.hero-stack {
		display: grid;
		gap: var(--space-4);
	}

	.hero-title {
		font-size: clamp(2.1rem, 5vw, 3.6rem);
		max-width: 12ch;
		text-wrap: balance;
	}

	.summary {
		font-size: 1rem;
		max-width: 34rem;
	}

	.hero-terminal {
		align-self: center;
		background: rgba(8, 18, 38, 0.42);
		border: 1px solid rgba(91, 231, 255, 0.12);
		border-radius: 1.25rem;
		box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.02);
		padding: 1rem;
	}

	.hero-terminal__screen {
		background:
			linear-gradient(180deg, rgba(91, 231, 255, 0.05), rgba(91, 231, 255, 0.015)),
			rgba(2, 8, 18, 0.56);
		border: 1px solid rgba(91, 231, 255, 0.1);
		border-radius: 1rem;
		display: grid;
		gap: 0.65rem;
		min-height: 9.5rem;
		padding: 1rem 1rem 1.05rem;
	}

	.typing-line {
		color: var(--text-bright);
		font-family: var(--font-display);
		font-size: 0.86rem;
		letter-spacing: 0.08em;
		line-height: 1.72;
		margin: 0;
		text-transform: uppercase;
	}

	.typing-line.is-active::after {
		animation: caret-blink 0.9s steps(1, end) infinite;
		color: var(--accent);
		content: "_";
		margin-left: 0.18rem;
	}

	.quote-shell::before {
		background:
			radial-gradient(
				circle at var(--quote-x, 50%) var(--quote-y, 50%),
				rgba(91, 231, 255, var(--quote-halo-opacity, 0.28)),
				transparent 24%
			);
		content: "";
		filter: blur(16px);
		inset: 3% 6%;
		position: absolute;
		z-index: 0;
	}

	.quote-kicker {
		justify-self: center;
	}

	.quote-surface {
		display: grid;
		gap: var(--space-6);
		min-height: clamp(16rem, 42vh, 23rem);
		place-items: center;
		overflow: hidden;
		padding: 1rem 0.2rem 0.4rem;
		position: relative;
		transform:
			translate3d(calc(var(--quote-shift-x, 0px) * 0.18), calc(var(--quote-shift-y, 0px) * 0.18), 0)
			scale(1.002);
		transition: transform var(--motion-base) var(--easing-standard);
		z-index: 1;
	}

	.quote-halo {
		background:
			radial-gradient(circle, rgba(244, 251, 255, 0.44), rgba(91, 231, 255, 0.1) 38%, transparent 72%);
		border-radius: 50%;
		filter: blur(22px);
		height: clamp(8rem, 20vw, 12rem);
		left: 50%;
		opacity: calc(var(--quote-halo-opacity, 0.28) + 0.08);
		position: absolute;
		top: 50%;
		transform:
			translate3d(
				calc(-50% + (var(--quote-shift-x, 0px) * 0.8)),
				calc(-50% + (var(--quote-shift-y, 0px) * 0.72)),
				0
			);
		transition:
			transform var(--motion-base) var(--easing-standard),
			opacity var(--motion-base) var(--easing-standard);
		width: clamp(8rem, 20vw, 12rem);
		z-index: 0;
	}

	.quote-shimmer {
		background:
			linear-gradient(90deg, rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.88), rgba(255, 255, 255, 0));
		filter: blur(6px);
		inset: 0 auto 0 -28%;
		opacity: 0.24;
		position: absolute;
		transform: skewX(-20deg);
		width: 18%;
		animation: quote-shimmer-pass 8.6s linear infinite;
		z-index: 1;
	}

	.quote-lines {
		display: grid;
		gap: 1.35rem;
		justify-items: center;
		position: relative;
		transform:
			translate3d(calc(var(--quote-shift-x, 0px) * -0.1), calc(var(--quote-shift-y, 0px) * -0.08), 0);
		transition: transform var(--motion-base) var(--easing-standard);
		z-index: 1;
	}

	.quote-line {
		font-family: var(--font-script);
		font-size: clamp(2.6rem, 5vw, 4.5rem);
		font-weight: 400;
		letter-spacing: 0.015em;
		line-height: 1.08;
		margin: 0;
		opacity: 0;
		text-align: center;
		text-wrap: balance;
		transform:
			translate3d(calc(var(--quote-shift-x, 0px) * 0.06), calc(var(--quote-shift-y, 0px) * 0.05), 0);
	}

	.quote-char {
		background:
			linear-gradient(90deg, #9fddff 0%, #f8feff 48%, #7ccfff 100%);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
		display: inline-block;
		filter: drop-shadow(0 0 10px rgba(91, 231, 255, 0.16));
		text-shadow:
			0 0 10px rgba(91, 231, 255, 0.28),
			0 0 22px rgba(255, 255, 255, 0.14);
	}

	.quote-underline {
		background: var(--divider-gradient);
		border-radius: 999px;
		box-shadow:
			0 0 16px rgba(91, 231, 255, 0.3),
			0 0 30px rgba(91, 231, 255, 0.12);
		height: 2px;
		margin: 0 auto;
		position: relative;
		width: min(100%, 64rem);
	}

	.focus-card {
		background: rgba(8, 18, 38, 0.46);
		border: 1px solid rgba(91, 231, 255, 0.12);
		border-radius: 1.2rem;
		display: grid;
		gap: 0.9rem;
		padding: 1.15rem 1.2rem;
	}

	.quote-underline::after {
		background:
			linear-gradient(90deg, rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.96), rgba(255, 255, 255, 0));
		content: "";
		inset: 0;
		position: absolute;
		transform: translateX(-130%);
		animation: divider-shimmer 6.2s linear infinite;
	}

	:global(html[data-js="ready"]) .quote-char {
		animation: quote-reveal 0.72s var(--easing-standard) both;
		animation-delay: calc(520ms + (var(--char-index) * 18ms));
		opacity: 0;
		transform: translateY(1rem) scale(0.98);
	}

	:global(html[data-js="ready"]) .quote-line {
		animation: quote-line-reveal 1s var(--easing-standard) both;
		animation-delay: calc(120ms + (var(--line-index) * 240ms));
	}

	@keyframes caret-blink {
		0%,
		49% {
			opacity: 1;
		}

		50%,
		100% {
			opacity: 0;
		}
	}

	@keyframes quote-shimmer-pass {
		0% {
			transform: translateX(-15%) skewX(-20deg);
		}

		100% {
			transform: translateX(730%) skewX(-20deg);
		}
	}

	@keyframes quote-reveal {
		0% {
			opacity: 0;
			transform: translateY(1rem) scale(0.98);
		}

		100% {
			opacity: 1;
			transform: translateY(0) scale(1);
		}
	}

	@keyframes quote-line-reveal {
		0% {
			clip-path: inset(0 0 100% 0);
			opacity: 0;
			transform:
				translate3d(
					calc(var(--quote-shift-x, 0px) * 0.06),
					calc(1rem + (var(--quote-shift-y, 0px) * 0.05)),
					0
				);
		}

		100% {
			clip-path: inset(0 0 0 0);
			opacity: 1;
			transform:
				translate3d(
					calc(var(--quote-shift-x, 0px) * 0.06),
					calc(var(--quote-shift-y, 0px) * 0.05),
					0
				);
		}
	}

	@media (max-width: 900px) {
		.hero-shell {
			grid-template-columns: 1fr;
		}

		.hero-title {
			max-width: 100%;
		}

		.quote-surface {
			min-height: clamp(14rem, 46vh, 20rem);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.quote-shell,
		.quote-shell::before,
		.quote-halo,
		.quote-surface,
		.quote-lines,
		.quote-line,
		.quote-shimmer,
		.quote-underline::after {
			animation: none;
			clip-path: none;
			transform: none;
			transition: none;
		}

		.quote-line {
			opacity: 1;
		}

		:global(html[data-js="ready"]) .quote-line,
		:global(html[data-js="ready"]) .quote-char,
		.quote-char {
			animation: none;
			opacity: 1;
			transform: none;
		}

		.typing-line.is-active::after {
			animation: none;
			content: "";
		}
	}
</style>
