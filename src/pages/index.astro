---
import SiteLayout from "../layouts/SiteLayout.astro";

const typingLines = [
	"[SYSTEM] PORTFOLIO SHELL LOADED",
	"[CLASS] PLACEHOLDER CONTENT LAYER",
	"[MISSION] SOLO UI VISUAL PASS ONLINE",
];
---

<SiteLayout
	title="Aoi Tsukikage Engineering"
	description="Solo Leveling inspired portfolio shell with native HUD interface, animated mission cards, and interactive quote treatment."
	currentPath={Astro.url.pathname}
>
	<div class="page-stack">
		<section class="quote-shell section-card" data-reveal id="home-quote" style="--reveal-order: 0;">
			<p class="section-kicker quote-kicker">[SYSTEM]</p>
			<div class="quote-frame">
				<img
					alt="Yesterday is history, tomorrow is a mystery, but today is a gift. That is why it is called the present."
					class="quote-image"
					height="226"
					loading="eager"
					src="/quote/quote-b-v4.svg"
					width="1400"
				/>
			</div>
		</section>

		<section class="hero-shell section-card" data-reveal id="home-hero" style="--reveal-order: 0;">
			<div class="hero-copy">
				<p class="section-kicker">[SYSTEM]</p>
				<h1 class="hero-title">A placeholder-safe portfolio shell shaped with calm, high-tech precision.</h1>
				<div class="hud-divider" aria-hidden="true"></div>
				<p class="summary">The content stays intentionally generic while the interface makes room for it to breathe.</p>
				<div class="meta-row">
					<span class="meta-chip">Solo UI Pass</span>
					<span class="meta-chip">Placeholder Safe</span>
				</div>
				<div class="cta-row">
					<a class="cta-link" href="/projects">View Projects</a>
					<a class="cta-link secondary" href="/contact">Contact</a>
				</div>
			</div>

			<div class="hero-stack">
				<aside class="hero-terminal" data-reveal style="--reveal-order: 1;">
					<div class="hero-terminal__screen" data-system-typing>
						{
							typingLines.map((line) => (
								<p class="typing-line is-complete" data-typing-line>{line}</p>
							))
						}
					</div>
				</aside>
			</div>
		</section>

		<section class="section-shell section-plain" data-reveal id="home-intro" style="--reveal-order: 2;">
			<p class="section-kicker">[SYSTEM]</p>
			<h2>Intro section placeholder now sits inside the same mission HUD language as the rest of the site.</h2>
			<div class="hud-divider" aria-hidden="true"></div>
			<p>
				Placeholder copy still defines the homepage overview, but the information
				hierarchy now reads like a unified system surface instead of isolated cards.
			</p>
		</section>

		<section class="section-shell section-plain" data-reveal id="home-focus-areas" style="--reveal-order: 3;">
			<p class="section-kicker">[SYSTEM]</p>
			<h2>Focus areas remain placeholders while the card treatment upgrades to brighter tactical panels.</h2>
			<div class="hud-divider" aria-hidden="true"></div>
			<div class="section-grid">
				<article class="focus-card" data-reveal style="--reveal-order: 4;">
					<h3>Placeholder focus area one</h3>
					<p>Reserved for short summary text and one future directional cue.</p>
				</article>
				<article class="focus-card" data-reveal style="--reveal-order: 5;">
					<h3>Placeholder focus area two</h3>
					<p>Reserved for short summary text and one future directional cue.</p>
				</article>
			</div>
		</section>

		<section class="section-shell section-plain" data-reveal id="home-featured-pointer" style="--reveal-order: 4;">
			<p class="section-kicker">[SYSTEM]</p>
			<h2>Featured pointer section keeps a clean route into Projects without changing the P4 data flow.</h2>
			<div class="hud-divider" aria-hidden="true"></div>
			<p>
				Only the pointer structure exists here. Project taxonomy and detail-page logic
				continue to stay collection-backed and untouched.
			</p>
			<div class="cta-row">
				<a class="cta-link" href="/projects">Open Projects Hub</a>
			</div>
		</section>

		<section class="section-card section-shell" data-reveal id="home-cta" style="--reveal-order: 5;">
			<p class="section-kicker">[SYSTEM]</p>
			<h2>Final CTA band exits the homepage with the same active system framing.</h2>
			<div class="hud-divider" aria-hidden="true"></div>
			<p>Placeholder CTA copy stays generic while the visual layer now feels deliberate and fully themed.</p>
			<div class="cta-row">
				<a class="cta-link" href="/about">Read About</a>
				<a class="cta-link secondary" href="/contact">Start Contact Route</a>
			</div>
		</section>
	</div>
</SiteLayout>

<style>
	.hero-shell {
		align-items: start;
		display: grid;
		gap: var(--space-6);
		grid-template-columns: minmax(0, 1.55fr) minmax(16rem, 0.8fr);
		padding: var(--panel-padding-lg);
	}

	.quote-shell {
		padding: clamp(1.3rem, 2vw, 1.7rem) clamp(1rem, 2vw, 1.45rem);
		text-align: center;
	}

	.hero-copy,
	.hero-stack {
		display: grid;
		gap: var(--space-4);
	}

	.hero-title {
		font-size: clamp(2.1rem, 5vw, 3.6rem);
		max-width: 12ch;
		text-wrap: balance;
	}

	.summary {
		font-size: 1rem;
		max-width: 34rem;
	}

	.hero-terminal {
		align-self: center;
		background: rgba(8, 18, 38, 0.42);
		border: 1px solid rgba(91, 231, 255, 0.12);
		border-radius: 1.25rem;
		box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.02);
		padding: 1rem;
	}

	.hero-terminal__screen {
		background:
			linear-gradient(180deg, rgba(91, 231, 255, 0.05), rgba(91, 231, 255, 0.015)),
			rgba(2, 8, 18, 0.56);
		border: 1px solid rgba(91, 231, 255, 0.1);
		border-radius: 1rem;
		display: grid;
		gap: 0.65rem;
		min-height: 9.5rem;
		padding: 1rem 1rem 1.05rem;
	}

	.typing-line {
		color: var(--text-bright);
		font-family: var(--font-display);
		font-size: 0.86rem;
		letter-spacing: 0.08em;
		line-height: 1.72;
		margin: 0;
		text-transform: uppercase;
	}

	.typing-line.is-active::after {
		animation: caret-blink 0.9s steps(1, end) infinite;
		color: var(--accent);
		content: "_";
		margin-left: 0.18rem;
	}

	.quote-kicker {
		justify-self: center;
	}

	.quote-frame {
		margin: 0 auto;
		max-width: min(100%, 70rem);
		width: 100%;
	}

	.quote-image {
		display: block;
		height: auto;
		margin: 0 auto;
		max-width: 100%;
		width: 100%;
	}

	.focus-card {
		background: rgba(8, 18, 38, 0.46);
		border: 1px solid rgba(91, 231, 255, 0.12);
		border-radius: 1.2rem;
		display: grid;
		gap: 0.9rem;
		padding: 1.15rem 1.2rem;
	}

	@keyframes caret-blink {
		0%,
		49% {
			opacity: 1;
		}

		50%,
		100% {
			opacity: 0;
		}
	}

	@media (max-width: 900px) {
		.hero-shell {
			grid-template-columns: 1fr;
		}

		.hero-title {
			max-width: 100%;
		}

		.quote-shell {
			padding-inline: clamp(0.9rem, 3vw, 1.2rem);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.typing-line.is-active::after {
			animation: none;
			content: "";
		}
	}
</style>
