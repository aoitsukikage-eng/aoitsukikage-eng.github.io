---
import { getCollection } from "astro:content";
import SiteLayout from "../layouts/SiteLayout.astro";
import { getResearchEntries } from "../lib/research";

import { zh } from "../i18n/zh";
import { en } from "../i18n/en";

const currentLocale = Astro.currentLocale ?? "zh";
const dict = currentLocale === "en" ? en : zh;

const TYPE_LABEL = {
	quantitative: { zh: "量化研究", en: "Quantitative" },
	comparative: { zh: "質化研究", en: "Qualitative" },
	narrative: { zh: "質化研究", en: "Qualitative" },
} as const;

const FEATURED_LABEL = { zh: "案例觀察", en: "Case observation" } as const;
const GROUP_ORDER = ["quantitative", "comparative", "narrative"] as const;

const allEntries = getResearchEntries(await getCollection("researchItems"));

const featured = allEntries.find((entry) => entry.data.featured === true) ?? null;
const gridEntries = allEntries
	.filter((entry) => entry !== featured)
	.sort(
		(left, right) =>
			GROUP_ORDER.indexOf(left.data.type) - GROUP_ORDER.indexOf(right.data.type) ||
			right.data.year - left.data.year ||
			left.data.title.localeCompare(right.data.title),
	);

const years = allEntries.map((entry) => entry.data.year);
const briefCount = String(allEntries.length).padStart(2, "0");
const yearRange = `${Math.min(...years)} — ${Math.max(...years)}`;

function cardView(entry: (typeof allEntries)[number], isFeatured: boolean) {
	const isLocaleMatch = entry.data.lang === currentLocale;
	const langName =
		currentLocale === "zh"
			? entry.data.lang === "en"
				? "英文"
				: "中文"
			: entry.data.lang === "zh"
				? "Traditional Chinese"
				: "English";

	return {
		href: entry.data.lang === "en" ? `/en/research/${entry.data.slug}/` : `/research/${entry.data.slug}/`,
		title: entry.data.cardTitle ?? entry.data.title,
		label: isFeatured
			? FEATURED_LABEL[currentLocale === "en" ? "en" : "zh"]
			: TYPE_LABEL[entry.data.type][currentLocale === "en" ? "en" : "zh"],
		blurb: isLocaleMatch
			? (entry.data.cardSummary ?? entry.data.summary)
			: dict.contentFallback.notice.replace("{lang}", langName),
		year: entry.data.year,
		tags: entry.data.tags,
	};
}
---

<SiteLayout
	title="Research | Aoi Tsukikage Engineering"
	description={dict.researchIndex.lede}
	currentPath={Astro.url.pathname}
>
	<div class="brief-panel" data-reveal style="--reveal-order: 0;">
		<header class="brief-head">
			<span class="brief-kicker">{dict.researchIndex.kicker}</span>
			<h1>{dict.researchIndex.heading}</h1>
			<p class="brief-lede">{dict.researchIndex.lede}</p>
		</header>

		<p class="brief-counter">{briefCount} {dict.researchIndex.briefsUnit} ／ {yearRange}</p>

		<div class="brief-slab">
			<div class="brief-grid">
				{gridEntries.map((entry) => {
					const card = cardView(entry, false);
					return (
						<article class="brief-card">
							<div class="brief-card-meta">
								<span class="brief-label">{card.label}</span>
								<span class="brief-year">{card.year}</span>
							</div>
							<h3><a href={card.href}>{card.title}</a></h3>
							<p>{card.blurb}</p>
							<div class="brief-tags">
								{card.tags.map((tag) => <span class="brief-tag">{tag}</span>)}
							</div>
						</article>
					);
				})}
			</div>

			{featured && (() => {
				const card = cardView(featured, true);
				return (
					<article class="brief-card brief-card-featured">
						<div class="brief-card-meta">
							<span class="brief-label">{card.label}</span>
							<span class="brief-sep" aria-hidden="true">/</span>
							<span class="brief-year">{card.year}</span>
						</div>
						<h3><a href={card.href}>{card.title}</a></h3>
						<p>{card.blurb}</p>
						<div class="brief-tags">
							{card.tags.map((tag) => <span class="brief-tag">{tag}</span>)}
						</div>
					</article>
				);
			})()}
		</div>
	</div>
</SiteLayout>

<style>
	.brief-panel {
		/* .content is a grid; without this the single child stretches to the
		   row height and the gradient's light end falls below the content. */
		align-self: start;
		background: var(--paper-sky-gradient);
		border: 1px solid var(--paper-border);
		border-radius: var(--radius-card);
		overflow: hidden;
		box-shadow: 0 18px 44px rgba(2, 6, 14, 0.45);
	}

	.brief-head {
		padding: clamp(2.2rem, 4vw, 3.6rem) clamp(1.4rem, 5vw, 4.4rem) clamp(1.6rem, 2.6vw, 2.75rem);
	}

	.brief-kicker {
		display: inline-block;
		font-family: "IBM Plex Mono", monospace;
		font-size: 0.7rem;
		letter-spacing: 0.14em;
		color: var(--accent-soft);
		border: 1px solid var(--border-strong);
		border-radius: 999px;
		padding: 0.4rem 0.95rem;
	}

	.brief-head h1 {
		margin: 1.5rem 0 1rem;
		max-width: 22ch;
		font-family: "Huninn", var(--font-heading);
		font-size: clamp(1.9rem, 3.4vw, 2.5rem);
		line-height: 1.3;
		font-weight: 700;
		color: var(--text-bright);
		text-wrap: pretty;
	}

	.brief-lede {
		margin: 0;
		max-width: 52ch;
		font-size: 0.906rem;
		line-height: 1.78;
		color: var(--text-dim);
		text-wrap: pretty;
	}

	.brief-counter {
		margin: 0;
		padding: 0 clamp(1.4rem, 5vw, 4.4rem) 1rem;
		text-align: right;
		font-family: "IBM Plex Mono", monospace;
		font-size: 0.7rem;
		letter-spacing: 0.14em;
		color: var(--text-muted);
	}

	.brief-slab {
		margin: 0 clamp(0.85rem, 3.9vw, 2.9rem) clamp(0.85rem, 3.9vw, 2.9rem);
		background: var(--paper);
		border: 1px solid var(--paper-border);
		box-shadow: 0 12px 34px rgba(10, 20, 40, 0.14);
	}

	.brief-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1px;
		background: var(--paper-border);
	}

	.brief-card {
		background: var(--paper);
		padding: clamp(1.5rem, 2.6vw, 2.15rem) clamp(1.5rem, 2.8vw, 2.25rem) clamp(1.35rem, 2.2vw, 1.9rem);
		display: flex;
		flex-direction: column;
		gap: 0.95rem;
	}

	.brief-card-meta {
		display: flex;
		justify-content: space-between;
		gap: 0.75rem;
		font-family: "IBM Plex Mono", monospace;
		font-size: 0.7rem;
		letter-spacing: 0.14em;
	}

	.brief-label { color: var(--ink-accent); }
	.brief-year { color: var(--ink-muted); }

	.brief-card h3 {
		margin: 0;
		font-family: "Huninn", var(--font-heading);
		font-size: 1.44rem;
		line-height: 1.42;
		font-weight: 700;
	}

	.brief-card h3 a {
		color: var(--ink);
		text-decoration: none;
	}

	.brief-card h3 a:hover,
	.brief-card h3 a:focus-visible {
		color: var(--ink-accent);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}

	.brief-card h3 a:focus-visible {
		outline: 2px solid var(--ink-accent);
		outline-offset: 3px;
		border-radius: 2px;
	}

	.brief-card p {
		margin: 0;
		font-size: 0.875rem;
		line-height: 1.75;
		color: var(--ink-dim);
		text-wrap: pretty;
	}

	.brief-tags {
		display: flex;
		gap: 0.56rem;
		flex-wrap: wrap;
		margin-top: auto;
		padding-top: 1.5rem;
	}

	.brief-tag {
		font-family: "IBM Plex Mono", monospace;
		font-size: 0.7rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--ink-accent);
		border: 1px solid var(--paper-accent-border);
		border-radius: 999px;
		padding: 0.42rem 0.92rem;
	}

	.brief-card-featured {
		border-top: 1px solid var(--paper-border);
		background: var(--paper-alt);
		padding: clamp(1.7rem, 2.9vw, 2.25rem) clamp(1.5rem, 2.8vw, 2.25rem) clamp(1.5rem, 2.4vw, 2rem);
	}

	.brief-card-featured .brief-card-meta { justify-content: flex-start; gap: 0.75rem; }
	.brief-sep { color: var(--ink-muted); }

	.brief-card-featured h3 { font-size: 1.7rem; line-height: 1.36; }
	.brief-card-featured p { max-width: 62ch; }
	.brief-card-featured .brief-tags { margin-top: 0; padding-top: 0.5rem; }

	@media (max-width: 760px) {
		.brief-grid { grid-template-columns: 1fr; }
	}
</style>
