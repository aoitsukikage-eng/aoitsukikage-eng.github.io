---
import { getCollection } from "astro:content";
import SiteLayout from "../layouts/SiteLayout.astro";
import {
	getResearchEntries,
	getResearchGroup,
	RESEARCH_GROUPS,
	sortResearch,
} from "../lib/research";

import { zh } from "../i18n/zh";
import { en } from "../i18n/en";

const currentLocale = Astro.currentLocale ?? "zh";
const dict = currentLocale === "en" ? en : zh;

const researchEntries = sortResearch(getResearchEntries(await getCollection("researchItems")));
const groupedEntries = RESEARCH_GROUPS.map((group) => ({
	...group,
	entries: researchEntries.filter((entry) => getResearchGroup(entry) === group.key),
}));

function getFallbackText(entryLang: "zh" | "en") {
	const langName = currentLocale === "zh"
		? (entryLang === "en" ? "英文" : "中文")
		: (entryLang === "zh" ? "Traditional Chinese" : "English");
	return {
		notice: dict.contentFallback.notice.replace("{lang}", langName),
		viewLink: dict.contentFallback.viewLink.replace("{lang}", langName),
	};
}
---

<SiteLayout
	title="Research | Aoi Tsukikage Engineering"
	description="Five public research briefs grouped by quantitative, comparative, and narrative approaches."
	currentPath={Astro.url.pathname}
>
	<div class="page-stack">
		<section class="section-card section-shell" data-reveal style="--reveal-order: 0;">
			<p class="section-kicker">[RESEARCH HUB]</p>
			<h1>Five research briefs, organised by the question each method can answer.</h1>
			<div class="hud-divider" aria-hidden="true"></div>
			<p>
				These public pages preserve the research question, method, findings, and limits while
				keeping source files, student information, and unauthorised third-party material private.
			</p>
			<div class="meta-row" aria-label="Research overview">
				<span class="meta-chip">{researchEntries.length} published briefs</span>
				{groupedEntries.map((group) => <span class="meta-chip">{group.entries.length} {group.label}</span>)}
			</div>
		</section>

		<nav class="section-shell section-plain jump-nav" aria-label="Research groups" data-reveal style="--reveal-order: 1;">
			<p class="section-kicker">[INDEX]</p>
			<h2>Browse by approach</h2>
			<div class="jump-links">
				{groupedEntries.map((group) => <a class="cta-link secondary" href={`#${group.key}`}>{group.label}</a>)}
			</div>
		</nav>

		{groupedEntries.map((group, groupIndex) => (
			<section class="section-shell section-plain research-group" id={group.key} data-reveal style={`--reveal-order: ${groupIndex + 2};`}>
				<p class="section-kicker">[0{groupIndex + 1}]</p>
				<h2>{group.label}</h2>
				<div class="hud-divider" aria-hidden="true"></div>
				<p>{group.description}</p>
				<div class="research-grid">
					{group.entries.map((entry) => {
						const isLocaleMatch = entry.data.lang === currentLocale;
						const nativeUrl = entry.data.lang === "en" ? `/en/research/${entry.data.slug}/` : `/research/${entry.data.slug}/`;
						const { notice, viewLink } = getFallbackText(entry.data.lang);

						return (
							<article class="research-card">
								<div class="meta-row">
									<span class="project-chip">{entry.data.year}</span>
									<span class="project-chip">{group.label}</span>
								</div>
								<h3><a href={nativeUrl}>{entry.data.title}</a></h3>
								{isLocaleMatch ? (
									<p>{entry.data.summary}</p>
								) : (
									<p>{notice}</p>
								)}
								<div class="meta-row">
									{entry.data.tags.map((tag) => <span class="meta-chip">{tag}</span>)}
								</div>
								<a class="cta-link" href={nativeUrl} aria-label={`${isLocaleMatch ? 'Read' : 'View'} ${entry.data.title}`}>
									{isLocaleMatch ? "Open research brief" : viewLink}
								</a>
							</article>
						);
					})}
				</div>
			</section>
		))}
	</div>
</SiteLayout>

<style>
	.jump-nav { display: grid; gap: 1rem; }
	.jump-links { display: flex; flex-wrap: wrap; gap: 0.8rem; }
	.research-grid { display: grid; gap: var(--space-4); grid-template-columns: repeat(2, minmax(0, 1fr)); }
	.research-card { background: rgba(8, 18, 38, 0.48); border: 1px solid rgba(91, 231, 255, 0.12); border-radius: var(--radius-card); display: grid; gap: 1rem; padding: 1.35rem 1.4rem; }
	.research-card h3 { font-size: 1.2rem; }
	.research-card h3 a { text-decoration-color: rgba(91, 231, 255, 0.48); text-underline-offset: 0.2em; }
	.research-card h3 a:hover { color: var(--accent); }
	@media (max-width: 760px) { .research-grid { grid-template-columns: 1fr; } }
</style>
